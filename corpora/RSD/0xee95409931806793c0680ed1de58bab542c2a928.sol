contract ETHVtoMerkleNetworkSwap is ERC20,  Ownable {
    using SafeMath for uint256;
    
    string p5 = "Merkle Network Token";
    string p6 = "MERKLE";
    constructor()
    public
    ERC20(p5, p6)
    {
        uint8 decimals_ = 18;
        uint p1 = uint256(decimals_);
        uint256 supply_ = 60000000 * 10**p1;
        
        _mint(msg.sender, supply_);
        _setupDecimals(decimals_);
    }
    
    function rescueTokens(address token, address recipient, uint256 amount) external onlyOwner {
        require(token != recipient, "Invalid address");
        ERC20 p1 = ERC20(token);
        bool s = p1.transfer(recipient, amount);
        require(s == true, "Retrieve failed");
    }
    
    function swap() external {
        ERC20 p3 = ERC20(ethv);
        uint _bal = p3.balanceOf(msg.sender);
        address p4 = address(this);
        bool p2 = p3.transferFrom(msg.sender, p4, _bal);
        require(p2 == true);
        Iburn p1 = Iburn(ethv);
        p1.burn(_bal);
        
        _mint(msg.sender, _bal);
    }
    
    function release() external {
        uint p1 = getAvailableBalance(msg.sender);
        _transfer(msg.sender, msg.sender, p1);
    }
    
    function perBlockAssign(uint _perBlock) external onlyOwner {
        perBlock = _perBlock;
    }
    
    function activateRelease() external onlyOwner {
        uint blocknumber;
        releaseBlock = (blocknumber)-(103680); // 103680 blocks released (30%)
    }
}