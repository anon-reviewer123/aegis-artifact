// SPDX-License-Identifier: UNLICENSED
pragma solidity 0.8.27;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

/**
 * @title EscrowERC20
 * @notice This contract allows users to lock and donate ERC20 tokens.
 */
contract EscrowERC20 is Pausable, ReentrancyGuard, AccessControl {
    using SafeERC20 for IERC20;

    /**
     * @notice ADMIN ROLE
     */
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");

    /**
     * @notice Timestamp when tokens are unlocked.
     */
    uint256 public unlockDate;

    /**
     * @notice User information struct.
     *
     * @param lockedAmount The amount of tokens locked by the user.
     * @param donatedAmount The amount of tokens donated by the user.
     */
    struct UserInfo {
        uint256 lockedAmount;
        uint256 donatedAmount;
    }

    /**
     * @notice Array with whitelisted tokens.
     */
    address[] public whitelistedTokensArray;

    /**
     * @notice Mapping to store user information.
     */
    mapping(address user => mapping(address token => UserInfo))
        public userInfos;

    /**
     * @notice Mapping to store whitelisted tokens.
     */
    mapping(address token => bool isWhitelisted) public whitelistedTokens;

    /**
     * @notice Total amount of locked tokens
     * @dev key: token address, value: total locked amount
     */
    mapping(address token => uint256 amount) public totalLocked;

    /**
     * @notice Total amount of donated tokens
     * @dev key: token address, value: total donated amount
     */
    mapping(address token => uint256 amount) public totalDonated;

    /**
     * @dev Emitted when tokens are locked.
     *
     * @param user The address of the user.
     * @param token The address of the token.
     * @param amount The amount of tokens locked.
     * @param timestamp The timestamp of the event.
     */
    event TokenLocked(
        address indexed user,
        address indexed token,
        uint256 amount,
        uint256 timestamp
    );

    /**
     * @dev Emitted when tokens are unlocked.
     *
     * @param user The address of the user.
     * @param token The address of the token.
     * @param amount The amount of tokens unlocked.
     * @param timestamp The timestamp of the event.
     */
    event TokenUnlocked(
        address indexed user,
        address indexed token,
        uint256 amount,
        uint256 timestamp
    );

    /**
     * @dev Emitted when tokens are donated to the contract.
     *
     * @param user The address of the user.
     * @param token The address of the token.
     * @param amount The amount of tokens donated.
     * @param timestamp The timestamp of the event.
     */
    event TokenDonated(
        address indexed user,
        address indexed token,
        uint256 amount,
        uint256 timestamp
    );

    /**
     * @dev Emitted when the whitelist status of a token is updated.
     *
     * @param token The address of the token.
     * @param isActive The new whitelist status of the token (true if whitelisted, false otherwise).
     * @param timestamp The timestamp of the event.
     */
    event TokenWhitelistUpdated(
        address indexed token,
        bool isActive,
        uint256 timestamp
    );

    /**
     * @dev Emitted when the unlock date is updated.
     *
     * @param unlockDate The new unlock date.
     */
    event UnlockDateUpdated(uint256 indexed unlockDate);

    /**
     * @dev Emitted when donated tokens are withdrawn by the admin.
     *
     * @param admin The address of the admin.
     * @param token The address of the token.
     * @param amount The amount of tokens withdrawn.
     */
    event DonatedTokensWithdrawn(
        address indexed admin,
        address indexed token,
        uint256 amount
    );

    /**
     * @notice Modifier to check if the contract is whitelisted.
     */
    modifier onlyWhitelisted(address token) {
        require(
            whitelistedTokens[token],
            "EscrowERC20: Token is not whitelisted"
        );
        _;
    }

    /**
     * @notice Constructor
     *
     * @param _unlockDate The unlock date for the locked tokens.
     */
    constructor(uint256 _unlockDate) {
        require(
            _unlockDate > block.timestamp,
            "EscrowERC20: Invalid unlock date"
        );
        unlockDate = _unlockDate;
        _grantRole(DEFAULT_ADMIN_ROLE, msg.sender);
        _grantRole(ADMIN_ROLE, msg.sender);
    }

    //  _               _
    // | |    ___   ___| | __
    // | |   / _ \ / __| |/ /
    // | |__| (_) | (__|   <
    // |_____\___/ \___|_|\_\

    /**
     * @notice Locks tokens in the contract.
     * @dev Only whitelisted tokens can be locked and should be approved by user before calling this function.
     *
     * @param token The address of the token to lock.
     * @param amount The amount of tokens to lock.
     */
    function lockTokens(
        address token,
        uint256 amount
    ) public onlyWhitelisted(token) whenNotPaused nonReentrant {
        require(
            amount != 0,
            "EscrowERC20: Amount of tokens must be greater than 0"
        );
        IERC20(token).safeTransferFrom(msg.sender, address(this), amount);
        totalLocked[token] += amount;
        userInfos[msg.sender][token].lockedAmount += amount;
        emit TokenLocked(msg.sender, token, amount, block.timestamp);
    }

    /**
     * @notice Unlocks user token from contrract
     *
     * @param token The address of the token to unlock.
     * @param amount The amount to unlock.
     */
    function unlockTokens(
        address token,
        uint256 amount
    ) external whenNotPaused nonReentrant {
        require(
            block.timestamp >= unlockDate,
            "EscrowERC20: Tokens are still locked"
        );
        require(token != address(0), "EscrowERC20: Token address cannot be 0");
        require(amount != 0, "EscrowERC20: Amount must be greater than 0");
        require(
            userInfos[msg.sender][token].lockedAmount >= amount,
            "EscrowERC20: Insufficient locked amount"
        );
        totalLocked[token] -= amount;
        userInfos[msg.sender][token].lockedAmount -= amount;
        IERC20(token).safeTransfer(msg.sender, amount);
        emit TokenUnlocked(msg.sender, token, amount, block.timestamp);
    }

    //  ____                    _
    // |  _ \  ___  _ __   __ _| |_ ___
    // | | | |/ _ \| '_ \ / _` | __/ _ \
    // | |_| | (_) | | | | (_| | ||  __/
    // |____/ \___/|_| |_|\__,_|\__\___|

    /**
     * @notice Donates tokens to the contract.
     * @dev Only whitelisted tokens can be donated and should be approved before calling this function.
     *
     * @param token The address of the token to donate.
     * @param amount The amount of tokens to donate.
     */
    function donateTokens(
        address token,
        uint256 amount
    ) public onlyWhitelisted(token) whenNotPaused nonReentrant {
        require(amount != 0, "EscrowERC20: Amount must be greater than 0");
        IERC20(token).safeTransferFrom(msg.sender, address(this), amount);
        totalDonated[token] += amount;
        userInfos[msg.sender][token].donatedAmount += amount;
        emit TokenDonated(msg.sender, token, amount, block.timestamp);
    }

    /**
     * @notice Donates locked tokens to the contract.
     * @dev Only whitelisted tokens can be donated.
     *
     * @param token The address of the token to donate.
     * @param amount The amount of tokens to donate.
     */
    function donateLockedTokens(
        address token,
        uint256 amount
    ) external onlyWhitelisted(token) whenNotPaused nonReentrant{
        require(amount != 0, "Amount must be greater than 0");
        require(
            userInfos[msg.sender][token].lockedAmount >= amount,
            "EscrowERC20: Insufficient locked amount"
        );
        totalLocked[token] -= amount;
        totalDonated[token] += amount;
        userInfos[msg.sender][token].lockedAmount -= amount;
        userInfos[msg.sender][token].donatedAmount += amount;
        emit TokenDonated(msg.sender, token, amount, block.timestamp);
    }

    function lockAndDonate(address token, uint256 lockamount, uint256 donateamount) external onlyWhitelisted(token) whenNotPaused nonReentrant {
        if(lockamount > 0) {
            lockTokens(token, lockamount);
        }
        if(donateamount > 0) {
            donateTokens(token, donateamount);
        }
    }

    //  ____       _   _
    // / ___|  ___| |_| |_ ___ _ __ ___
    // \___ \ / _ \ __| __/ _ \ '__/ __|
    //  ___) |  __/ |_| ||  __/ |  \__ \
    // |____/ \___|\__|\__\___|_|  |___/

    /**
     * @notice Sets the unlock date for the contract.
     * @dev Only the admin can call this function.
     *
     * @param _unlockDate  The new unlock date.
     */
    function setUnlockDate(uint256 _unlockDate) external onlyRole(ADMIN_ROLE) {
        require(
            _unlockDate > block.timestamp,
            "EscrowERC20: Invalid unlock date"
        );
        unlockDate = _unlockDate;
        emit UnlockDateUpdated(_unlockDate);
    }

    /**
     * @notice Adds a token to the whitelist.
     *
     * @param token The address of the token to whitelist.
     */
    function setWhitelistedAddress(
        address token
    ) external onlyRole(ADMIN_ROLE) {
        require(token != address(0), "EscrowERC20: Token address cannot be 0");
        require(
            !whitelistedTokens[token],
            "EscrowERC20: Token is already in whitelist"
        );
        whitelistedTokens[token] = true;
        whitelistedTokensArray.push(token);
        emit TokenWhitelistUpdated(token, true, block.timestamp);
    }

    /**
     * @notice Removes a token from the whitelist.
     *
     * @param token The token address to remove from the whitelist.
     */
    function removeWhitelistedAddress(
        address token
    ) external onlyWhitelisted(token) onlyRole(ADMIN_ROLE) {
        uint256 arrayLength = whitelistedTokensArray.length;
        for (uint256 i; i < arrayLength; i++) {
            if (whitelistedTokensArray[i] == token) {
                whitelistedTokensArray[i] = whitelistedTokensArray[
                    arrayLength - 1
                ];
                whitelistedTokensArray.pop();
                break;
            }
        }
        whitelistedTokens[token] = false;
        emit TokenWhitelistUpdated(token, false, block.timestamp);
    }

    //   ____      _   _
    //  / ___| ___| |_| |_ ___ _ __ ___
    // | |  _ / _ \ __| __/ _ \ '__/ __|
    // | |_| |  __/ |_| ||  __/ |  \__ \
    //  \____|\___|\__|\__\___|_|  |___/

    /**
     * @notice Returns the locked tokens of a user.
     *
     * @param user The address of the user.
     * @return tokens The addresses of the whitelisted tokens.
     * @return balances The balances of the user.
     */
    function getUserLockedTokens(
        address user
    )
        external
        view
        returns (address[] memory tokens, uint256[] memory balances)
    {
        uint256 arrayLength = whitelistedTokensArray.length;
        balances = new uint256[](arrayLength);
        for (uint256 i; i < arrayLength; i++) {
            balances[i] = userInfos[user][whitelistedTokensArray[i]]
                .lockedAmount;
        }

        return (whitelistedTokensArray, balances);
    }

    /**
     * @notice Returns the donated tokens of a user.
     *
     * @param user The address of the user.
     * @return tokens The addresses of the whitelisted tokens.
     * @return balances The balances of the user.
     */
    function getUserDonatedTokens(
        address user
    )
        external
        view
        returns (address[] memory tokens, uint256[] memory balances)
    {
        uint256 arrayLength = whitelistedTokensArray.length;
        balances = new uint256[](arrayLength);
        for (uint256 i; i < arrayLength; i++) {
            balances[i] = userInfos[user][whitelistedTokensArray[i]]
                .donatedAmount;
        }
        return (whitelistedTokensArray, balances);
    }

    /**
     * @notice Returns the total locked amount of a token.
     *
     * @param token The address of the token.
     * @return total The total locked amount of the token.
     */
    function getTotalLocked(
        address token
    ) external view returns (uint256 total) {
        return totalLocked[token];
    }

    /**
     * @notice Returns the total donated amount of a token.
     *
     * @param token The address of the token.
     * @return total The total donated amount of the token.
     */
    function getTotalDonated(
        address token
    ) external view returns (uint256 total) {
        return totalDonated[token];
    }

    function getWhitelistedTokens() external view returns (address[] memory) {
        return whitelistedTokensArray;
    }

    // __        ___ _   _         _
    // \ \      / (_) |_| |__   __| |_ __ __ ___      __
    //  \ \ /\ / /| | __| '_ \ / _` | '__/ _` \ \ /\ / /
    //   \ V  V / | | |_| | | | (_| | | | (_| |\ V  V /
    //    \_/\_/  |_|\__|_| |_|\__,_|_|  \__,_| \_/\_/

    /**
     * @notice Withdraws ERC20 tokens from the contract.
     * @dev Only the admin can call this function.
     *
     * @param token The token address to withdraw.
     * @param amount The amount of tokens to withdraw.
     */
    function withdrawDonatedTokens(
        address token,
        uint256 amount
    ) external onlyRole(ADMIN_ROLE) nonReentrant {
        require(token != address(0), "EscrowERC20: Token address cannot be 0");
        require(amount != 0, "EscrowERC20: Amount must be greater than 0");
        require(totalDonated[token] >= amount, "EscrowERC20: Invalid amount");
        totalDonated[token] -= amount;
        IERC20(token).safeTransfer(msg.sender, amount);
        emit DonatedTokensWithdrawn(msg.sender, token, amount);
    }

    /**
     * @notice Withdraws ERC20 tokens from the contract.
     * @dev Only the admin can call this function. You can't withdraw whitelisted tokens.
     *
     * @param token The token address to withdraw.
     * @param amount The amount of tokens to withdraw.
     */
    function withdrawERC20Tokens(
        address token,
        uint256 amount
    ) external onlyRole(ADMIN_ROLE) nonReentrant {
        require(!whitelistedTokens[token], "EscrowERC20: Token is whitelisted");
        require(token != address(0), "EscrowERC20: Token address cannot be 0");
        require(amount != 0, "EscrowERC20: Amount must be greater than 0");
        IERC20(token).safeTransfer(msg.sender, amount);
    }

    /**
     * @notice Withdraws the ETH balance from the contract.
     * @dev Only the admin can call this function.
     */
    function withdrawETH(
        uint256 amount
    ) external onlyRole(ADMIN_ROLE) nonReentrant {
        (bool success, ) = payable(msg.sender).call{value: amount}("");
        require(success, "EscrowERC20: Transfer failed");
    }

    /**
     * @notice Pauses protocol
     *
     * @dev Only the admin can call this function.
     */
    function pause() external onlyRole(ADMIN_ROLE) {
        _pause();
    }

    /**
     * @notice Unpauses protocol.
     *
     * @dev Only the admin can call this function.
     */
    function unpause() external onlyRole(ADMIN_ROLE) {
        _unpause();
    }

    receive() external payable {}
}
