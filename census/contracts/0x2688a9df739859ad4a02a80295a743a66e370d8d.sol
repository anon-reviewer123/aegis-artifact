pragma solidity ^0.8.28;

import { AccessControlUpgradeable } from "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import { ERC20Upgradeable } from "@openzeppelin/contracts-upgradeable/token/ERC20/ERC20Upgradeable.sol";
import { ERC20BurnableUpgradeable } from
    "@openzeppelin/contracts-upgradeable/token/ERC20/extensions/ERC20BurnableUpgradeable.sol";
import { Initializable } from "@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol";
import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import { ReentrancyGuardUpgradeable } from "@openzeppelin/contracts-upgradeable/utils/ReentrancyGuardUpgradeable.sol";
import { PausableUpgradeable } from "@openzeppelin/contracts-upgradeable/utils/PausableUpgradeable.sol";

import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import { IERC4626 } from "@openzeppelin/contracts/interfaces/IERC4626.sol";

import { EventsLib } from "./libraries/EventsLib.sol";
import { ErrorsLib } from "./libraries/ErrorsLib.sol";
import { PercentageMath } from "./libraries/PercentageMath.sol";

contract HakutoraSusdfVault is
    Initializable,
    ERC20Upgradeable,
    ERC20BurnableUpgradeable,
    AccessControlUpgradeable,
    PausableUpgradeable,
    ReentrancyGuardUpgradeable
{
    using SafeERC20 for IERC20;
    using SafeERC20 for IERC4626;

    bytes32 public constant MANAGER_ROLE = keccak256("MANAGER_ROLE");

    struct Position {
        bool isRedeemed;
        uint256 usdfAmount;
        uint256 susdfShares;
    }

    IERC4626 public sUSDF;
    IERC20 public usdf;

    address public vault;
    address public feeRecipient;
    uint256 public feeRate;
    uint256 public minDepositAmount;

    mapping(address => Position[]) public positions;

    /// @custom:oz-upgrades-unsafe-allow constructor
    constructor() {
        _disableInitializers();
    }

    function initialize(address _defaultAdmin, address _vault, address _usdf, address _sUSDF) public initializer {
        __ERC20_init("Hakutora Staked Falcon USD", "hsUSDf");
        __ERC20Burnable_init();
        __AccessControl_init();
        __Pausable_init();
        __ReentrancyGuard_init();

        if (_defaultAdmin == address(0) || _usdf == address(0) || _sUSDF == address(0)) revert ErrorsLib.ZERO_ADDRESS();
        if (_vault == address(0)) revert ErrorsLib.ZERO_ADDRESS();

        _grantRole(DEFAULT_ADMIN_ROLE, _defaultAdmin);
        _grantRole(MANAGER_ROLE, _defaultAdmin);

        usdf = IERC20(_usdf);
        sUSDF = IERC4626(_sUSDF);

        minDepositAmount = 0;
        feeRecipient = _defaultAdmin;
        feeRate = 1500;
        vault = _vault;
    }

    function deposit(
        address _beneficiary,
        uint256 _amount,
        uint256 _minShares
    )
        external
        nonReentrant
        whenNotPaused
        returns (uint256)
    {
        if (_amount < minDepositAmount) revert ErrorsLib.INSUFFICIENT_AMOUNT();
        if (_beneficiary == address(0)) revert ErrorsLib.ZERO_ADDRESS();

        usdf.safeIncreaseAllowance(address(sUSDF), _amount);

        usdf.safeTransferFrom(msg.sender, address(this), _amount);

        uint256 shares = sUSDF.deposit(_amount, vault);
        if (shares < _minShares) revert ErrorsLib.INSUFFICIENT_SHARES();

        _mint(_beneficiary, shares);
        positions[_beneficiary].push(Position({ isRedeemed: false, usdfAmount: _amount, susdfShares: shares }));

        emit EventsLib.Deposit(_beneficiary, _amount, shares, positions[_beneficiary].length - 1);

        return shares;
    }

    function redeem(uint256 positionId) public nonReentrant whenNotPaused returns (uint256) {
        Position[] storage userPositions = positions[msg.sender];
        if (positionId >= userPositions.length) revert ErrorsLib.INVALID_POSITION_ID();

        Position storage position = userPositions[positionId];
        if (position.isRedeemed) revert ErrorsLib.POSITION_ALREADY_REDEEMED();

        position.isRedeemed = true;
        _burn(msg.sender, position.susdfShares);

        sUSDF.safeTransferFrom(vault, address(this), position.susdfShares);

        uint256 usdfRedeemedAmount = sUSDF.redeem(position.susdfShares, address(this), address(this));

        (uint256 receivedAmount, uint256 fee) = _calculateFee(usdfRedeemedAmount, position.usdfAmount);

        usdf.safeTransfer(msg.sender, receivedAmount);
        usdf.safeTransfer(feeRecipient, fee);

        emit EventsLib.Redeem(msg.sender, usdfRedeemedAmount, position.susdfShares, positionId);

        return receivedAmount;
    }

    function batchRedeem(uint256[] memory positionIds) external whenNotPaused returns (uint256) {
        uint256 totalRedeemedAmount = 0;
        for (uint256 i = 0; i < positionIds.length; i++) {
            totalRedeemedAmount += redeem(positionIds[i]);
        }
        return totalRedeemedAmount;
    }

    function setFeeRecipient(address _feeRecipient) external onlyRole(MANAGER_ROLE) {
        if (_feeRecipient == address(0)) revert ErrorsLib.INVALID_FEE_RECIPIENT();

        feeRecipient = _feeRecipient;

        emit EventsLib.SetFeeRecipient(feeRecipient, _feeRecipient);
    }

    function setFeeRate(uint256 _feeRate) external onlyRole(MANAGER_ROLE) {
        if (_feeRate > 1500) revert ErrorsLib.INVALID_FEE_RATE();
        feeRate = _feeRate;

        emit EventsLib.SetFeeRate(feeRate, _feeRate);
    }

    function setMinDepositAmount(uint256 _minDepositAmount) external onlyRole(MANAGER_ROLE) {
        minDepositAmount = _minDepositAmount;
        emit EventsLib.SetMinDepositAmount(minDepositAmount, _minDepositAmount);
    }

    function setVault(address _vault) external onlyRole(MANAGER_ROLE) {
        if (_vault == address(0)) revert ErrorsLib.ZERO_ADDRESS();

        vault = _vault;
        emit EventsLib.SetVault(vault, _vault);
    }

    function pause() external onlyRole(MANAGER_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(MANAGER_ROLE) {
        _unpause();
    }

    function previewRedeemList(
        address _onbehalfOf,
        uint256[] memory _positionIds
    )
        external
        view
        returns (uint256[] memory)
    {
        uint256[] memory usdfRedeemedAmounts = new uint256[](_positionIds.length);
        Position[] memory userPositions = positions[_onbehalfOf];

        for (uint256 i = 0; i < _positionIds.length; i++) {
            Position memory position = userPositions[_positionIds[i]];
            (uint256 usdfRedeemedAmount,) = calculateFee(position.susdfShares, position.usdfAmount);
            usdfRedeemedAmounts[i] = usdfRedeemedAmount;
        }

        return usdfRedeemedAmounts;
    }

    function getPositionLength(address _onbehalfOf) external view returns (uint256) {
        return positions[_onbehalfOf].length;
    }

    function calculateFee(uint256 _susdfShares, uint256 _depositAmount) public view returns (uint256, uint256) {
        uint256 usdfRedeemedAmount = sUSDF.previewRedeem(_susdfShares);
        return _calculateFee(usdfRedeemedAmount, _depositAmount);
    }

    function _calculateFee(
        uint256 _usdfRedeemedAmount,
        uint256 _depositAmount
    )
        internal
        view
        returns (uint256, uint256)
    {
        uint256 fee = 0;
        if (_usdfRedeemedAmount > _depositAmount) {
            fee = PercentageMath.percentMul(_usdfRedeemedAmount - _depositAmount, feeRate);
        }
        return (_usdfRedeemedAmount - fee, fee);
    }
}

