// SPDX-License-Identifier: none
pragma solidity ^0.8.13;

import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@uniswap/v2-periphery/contracts/interfaces/IUniswapV2Router02.sol"; 
import { EventEmitter } from "./EventEmitter.sol";
  
interface IWETH {    
    function deposit() external payable;
}

contract Bonds is Ownable {
	using SafeERC20 for IERC20;

	/* ======== STATE VARIABLES ======== */

	address public token; // token token
	address public usdc; // asset used to create bond
    IWETH public weth;
	 
	IUniswapV2Router02 router; 
    uint128 maxBonds = 30;
	address public wallet;   
	bool enabled;

	struct Bond {
		uint256 amount;  
		uint128 startTime;
		uint128 duration; 
	}
	mapping(address => mapping(uint256 => mapping(uint256 => Bond))) public bonds;
	struct BondInfo {
		uint256 startIndex;
		uint256 endIndex;
	}
	mapping(address => mapping(uint256 => BondInfo)) public bondsInfo;
	mapping(address => uint256) public balances;

	uint256 public totalSold;	
    uint256 public totalLocked;	
	uint256 public rewerdsSupply;

    uint256 private decimals;
	
	uint256 private constant MULTIPLIER = 1000;
	struct Terms {		
		uint128 duration; // vest duration 
		uint256 bonus; // percent of bonus
	}
	 mapping(uint256 => Terms)public terms;

    uint256[] public durations;

    mapping(address => address[]) public supportedTokens;

	/* ======== constructor ======== */
	constructor (
        address token_,
		address usdc_,
		address router_ 
    ) Ownable(msg.sender) {         
		token = token_;
		usdc = usdc_; 
		 
		router = IUniswapV2Router02(router_);
        weth = IWETH(router.WETH()); 

        decimals = IERC20Metadata(token).decimals(); 
    }
	 
	function setTerms(  
		Terms[] calldata _terms
	) external onlyOwner {	
        require(durations.length == 0, "Already set"); 	 
		for (uint256 i = 0; i < _terms.length; i++) {
            durations.push(_terms[i].duration);
            terms[_terms[i].duration] = _terms[i];
        }  
		setEnabled(true);		  
	}

	function setBonus(  
		Terms[] calldata _terms
	) external onlyOwner {	
        require(durations.length > 0, "Not set"); 	 
		for (uint256 i = 0; i < _terms.length; i++) { 
            terms[_terms[i].duration].bonus = _terms[i].bonus;
        }  	  
	}
 
	function setEnabled(bool state_) public onlyOwner {
		enabled = state_;
		emit SetEnabled(state_);
	}

	function setSupportedTokens(address token_, address[] memory path_) public onlyOwner {
		supportedTokens[token_] = path_;		
	}

    function supply(uint256 amount_) external {         
		IERC20(token).safeTransferFrom(msg.sender, address(this), amount_);
		rewerdsSupply += amount_;
	}

	function withdrawAllSupplied(address to) external onlyOwner {
		uint256 available = IERC20(token).balanceOf(address(this)) - totalLocked;
		require(available > 0, "No unlocked tokens");
		IERC20(token).safeTransfer(to, available);
	}
		
	/* ======== VIEW ======== */
	struct TokenData {	
		uint256 balance; 
		uint256 allowance; 	
	}
			
    function aggregate(address account_, address[] memory tokens_)
		public
		view
		returns (
            Terms[] memory _terms,
            uint256 _price,	
            uint256 _totalSold,
			uint256 _balance,
            uint256 _tokenBalance,
            uint256 _ethBalance,
			TokenData[] memory _tokens,
            uint256 _timestamp			
		)
	{
        _terms = new Terms[](durations.length);

        for (uint256 i = 0; i < durations.length; i++) {
			uint256 duration = durations[i];
			_terms[i] = terms[duration];
		}

        _price = priceInUsd();
		_totalSold = totalSold;
		_balance = balances[account_];	
        _timestamp = block.timestamp;

        _tokenBalance = IERC20(token).balanceOf(account_);
        _ethBalance = address(account_).balance;
		
		_tokens = new TokenData[](tokens_.length);
		for (uint256 i = 0; i < tokens_.length; i++) {
			address t = tokens_[i];
			if (t == address(0)) {
				_tokens[i].balance = account_.balance;
			} else {
				_tokens[i].balance = IERC20(t).balanceOf(account_);
				_tokens[i].allowance = IERC20(t).allowance(account_, address(this));
			}			
		}		
	}
 
	function priceInUsd() public view returns (uint256 _price) {
		address[] memory path = new address[](3);
		path[0] = address(usdc);
        path[1] = address(weth);     
        path[2] = address(token);  
        _price = price(path);     	
	}
  
	function price(address[] memory path) public view returns (uint256 _price) {
		uint256[] memory amountsOut = router.getAmountsOut(10 ** decimals, path); // decimals of USDC, usually 6 
		_price = amountsOut[amountsOut.length - 1]; // Final token amount
	}

    function tokenValue(address token_, uint256 amount_) public view returns (uint256 _value) {
        _value = (amount_ * (10**decimals)) / (10**IERC20Metadata(token_).decimals());
    }

	function payoutForAsset(uint256 value_) public view returns (uint256 _payout) {			
        _payout = ( tokenValue(address(usdc), value_) * (10**decimals)) / tokenValue(address(usdc), priceInUsd());
	}

	function payoutFor(uint256 amount_, address[] memory path) public view returns (uint256 _payout) {	
		uint256[] memory amountsOut = router.getAmountsOut(amount_, path);   
        return amountsOut[amountsOut.length - 1];
	}
		
	/* ======== USER ======== */ 
	 
	function buy(
        address token_,
		uint256 amount_,
		uint256 minPayout_,
        uint256 duration_	
	) external payable onlyEnabled returns (uint256 _payout) {		 	
		require(terms[duration_].duration == duration_, "Wrong duration"); 
		
		if (token_ == address(0)) {
			require(amount_ == msg.value, "Wrong ETH amount"); 
			weth.deposit{ value: msg.value }();
			token_ = address(weth);
		} else {
            require(supportedTokens[token_].length != 0, 'Token not supported');
			IERC20(token_).safeTransferFrom(msg.sender, address(this), amount_);
		}
		
		IERC20(token_).approve(address(router), amount_);   

		uint256 balanceBefore = IERC20(token).balanceOf(address(this)); 
		
		router.swapExactTokensForTokensSupportingFeeOnTransferTokens(
			amount_, // uint256 amountIn
			minPayout_, // uint256 amountOutMin
			supportedTokens[token_], // address[] calldata path
			address(this), // to
			block.timestamp // deadline
		);
		uint256 balanceAfter = IERC20(token).balanceOf(address(this));
		_payout = balanceAfter - balanceBefore;
		 
		// update user vest bonds and release vested
		_release(msg.sender);

        totalSold += _payout;

        Terms memory t = terms[duration_];

        _payout = _payout + _payout * t.bonus / MULTIPLIER;

		uint256 available = IERC20(token).balanceOf(address(this)) - totalLocked;
		require(available >= _payout, "Not enough tokens supplied");

        totalLocked += _payout;
        balances[msg.sender] += _payout;
		
		 
		BondInfo storage bondInfo = bondsInfo[msg.sender][duration_];
		require(bondInfo.endIndex < maxBonds, "Too much bonds. Wait until older expire");			
		bonds[msg.sender][duration_][bondInfo.endIndex] = Bond({ 
			amount: _payout, 
			startTime: uint128(block.timestamp), 
			duration: uint128(duration_) 
		});
		bondInfo.endIndex ++;
		
        require(IERC20(token).balanceOf(address(this)) >= totalLocked, "Not enough tokens");

		emit Buy(msg.sender, amount_, _payout, duration_);
	}

	function release(address account_) public returns (uint256 _released, BondsData[] memory _bondsData) {
		return _release(account_);
	}


    struct BondsData {	
		Bond[] _bonds;	
	}
	// Update and release currently available locked tokens gradually over duration period
	function _release(address account_) internal returns (uint256 _released, BondsData[] memory _bondsData) { 
        _bondsData = new BondsData[](durations.length);
        for (uint256 a = 0; a < durations.length; a++) { 
            uint256 duration = 	durations[a]; 

            BondInfo storage bondInfo = bondsInfo[account_][duration];
            // return if user has no bonds
            if (bondInfo.endIndex == 0) continue;
            
            uint256 startIndex = bondInfo.startIndex;
            uint256 endIndex = bondInfo.endIndex;
            _bondsData[a]._bonds = new Bond[](endIndex - startIndex);	
            
            uint idx;	
            for (uint256 i = startIndex; i < endIndex; i++) {
                Bond storage bond = bonds[account_][duration][i]; 
                uint256 endTime = bond.startTime + bond.duration; 
                if (endTime <= block.timestamp) {
                    _released += bond.amount;
                    delete bonds[account_][duration][i];
                    bondInfo.startIndex ++;
                } 
                _bondsData[a]._bonds[idx] = bond;
                idx ++;
            }

            // if end reached it means no lock found and we can reset startedIndex and clear all bonds array
            if (bondInfo.startIndex >= bondInfo.endIndex) {
                bondInfo.startIndex = 0;
                bondInfo.endIndex = 0;
            } 
        }
		 
		if (_released != 0) {
			balances[account_] -= _released; 
            totalLocked  -= _released; 
			IERC20(token).transfer(account_, _released);
		} 
	}
 
	/* ======== EVENTS ======== */

	event InitTerms(Terms terms);
	event SetTerms(Terms terms);
	event SetEnabled(bool state);
	event SetWallet(address wallet);
    event SetAsset(address asset);
		
	event Buy(address indexed account, uint256 assetAmount,  uint256 payoutAmount, uint256 duration);
	
	/* ======== MODIFIERS ======== */  
	modifier onlyEnabled() {
		require(enabled, "Not enabled");
		_;
	}
}

