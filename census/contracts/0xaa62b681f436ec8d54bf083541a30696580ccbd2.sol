pragma solidity ^0.8.19;
  
import "@openzeppelin/contracts/access/Ownable.sol";
  
contract EventEmitter is Ownable {
	mapping(address => bool) public emitters; 

    constructor() Ownable(msg.sender) { }
     
    function setEmitters(address[] calldata emitters_, bool state_) public onlyOwner {
        for (uint256 i = 0; i < emitters_.length; i++) {
            emitters[emitters_[i]] = state_;
        }
        		
	}

    function emitEvent(bytes32 action, bytes memory data) public {
		require(emitters[msg.sender], "Emitter!");
        emit Event(action, data, uint40(block.timestamp), tx.origin); 
	}
		
    event Event(bytes32 action, bytes data, uint256 timestamp, address origin);	
}