// SPDX-License-Identifier: MIT
pragma solidity ^0.8.19;

import "./interfaces/ReentrancyGuard.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

import "./interfaces/IPool.sol";
import "./interfaces/IUniswapV2Router02.sol";
import "./interfaces/I1inchRouter.sol";

contract OptimizedMEVArbitrage is ReentrancyGuard, Ownable {
    using SafeERC20 for IERC20;
    uint256 public maxEthLimit = 0.1 ether;
    uint256 public totalEthUsed = 0;

    IPool private aavePool;
    IUniswapV2Router02 private uniswapRouter;
    IUniswapV2Router02 private sushiswapRouter;
    I1inchRouter private inchRouter;
    uint256 private constant slippageTolerance = 2;
    address private constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;

    event ArbitrageExecuted(address indexed tokenIn, address indexed tokenOut, uint256 amount, uint256 profit);
    event FlashLoanRequested(address indexed token, uint256 amount);
    event FlashLoanRepaid(address indexed token, uint256 amount);

    constructor(
        address _aavePool,
        address _uniswapRouter,
        address _sushiswapRouter,
        address _inchRouter
    ) Ownable(msg.sender) {
        aavePool = IPool(_aavePool);
        uniswapRouter = IUniswapV2Router02(_uniswapRouter);
        sushiswapRouter = IUniswapV2Router02(_sushiswapRouter);
        inchRouter = I1inchRouter(_inchRouter);
    }

    function executeArbitrage(
        address tokenIn,
        address tokenOut,
        uint256 amount
    ) external onlyOwner nonReentrant {
        uint256 maxTradeSize = 1 ether; // Obergrenze für den Flash Loan
        uint256 tradeSize = amount > maxTradeSize ? maxTradeSize : amount;

        require(tradeSize <= 0.01 ether, "Maximal 0.01 ETH pro Trade erlaubt!");
        require(isProfitableArbitrage(tokenIn, tokenOut, tradeSize), "Arbitrage not profitable");
        require(IERC20(tokenIn).balanceOf(address(this)) >= tradeSize, "Nicht genuegend Token fuer Arbitrage!");


    emit FlashLoanRequested(tokenIn, tradeSize);
        try aavePool.flashLoan(address(this), tokenIn, tradeSize, address(this), "", 0) {
            emit FlashLoanRequested(tokenIn, tradeSize);
        } catch {
            revert("Flash Loan fehlgeschlagen!");
        }

    }


    function executeOperation(
        address tokenIn,
        uint256 amount,
        uint256 premium
    ) external nonReentrant returns (bool) {
        require(msg.sender == address(aavePool), "Caller is not AAVE pool");

        address bestToken = getBestTradeToken(tokenIn);
        uint256 initialBalance = IERC20(tokenIn).balanceOf(address(this));

        arbitrageTrade(tokenIn, bestToken, amount);

        uint256 finalBalance = IERC20(tokenIn).balanceOf(address(this));
        uint256 profit = finalBalance - initialBalance;
        require(profit > premium, "Arbitrage not profitable after fees");

        uint256 amountOwed = amount + premium;
        IERC20(tokenIn).safeIncreaseAllowance(address(aavePool), amountOwed);
        IERC20(tokenIn).safeTransfer(address(aavePool), amountOwed);

        emit FlashLoanRepaid(tokenIn, amountOwed);
        emit ArbitrageExecuted(tokenIn, bestToken, amount, profit);

        return true;
    }

    function getLiquidity(address token, address router) public view returns (uint256) {
        address[] memory path = new address[](2);
        path[0] = token;
        path[1] = USDC;

        uint256 liquidity;
        try IUniswapV2Router02(router).getAmountsOut(1, path) returns (uint256[] memory amounts) {
            liquidity = amounts[1];
        } catch {
            liquidity = 0;
        }
        return liquidity;
    }

    function getPath(address tokenIn, address tokenOut) private pure returns (address[] memory path) {
        path = new address[](2);
        path[0] = tokenIn;
        path[1] = tokenOut;
        return path;
    }

    function arbitrageTrade(address tokenIn, address tokenOut, uint256 amount) private {
        uint256 bestMinOut = getAmountOutMin(tokenIn, tokenOut, amount, uniswapRouter);

        IERC20(tokenIn).safeIncreaseAllowance(address(uniswapRouter), amount);
        uniswapRouter.swapExactTokensForTokens(
            amount,
            bestMinOut * (100 - slippageTolerance) / 100,
            getPath(tokenIn, tokenOut),
            address(this),
            block.timestamp + 1
        );
    }

    function getAmountOutMin(
        address tokenIn,
        address tokenOut,
        uint256 amountIn,
        IUniswapV2Router02 router
    ) private view returns (uint256) {
        try router.getAmountsOut(amountIn, getPath(tokenIn, tokenOut)) returns (uint256[] memory amounts) {
            return amounts[1];
        } catch {
            return 0;
        }
    }

    function getBestTradeToken(address tokenIn) public view returns (address) {
        uint256 uniswapLiquidity = getLiquidity(tokenIn, address(uniswapRouter));
        uint256 sushiswapLiquidity = getLiquidity(tokenIn, address(sushiswapRouter));
        uint256 inchLiquidity = getLiquidity(tokenIn, address(inchRouter));

        if (uniswapLiquidity >= sushiswapLiquidity && uniswapLiquidity >= inchLiquidity) {
            return address(uniswapRouter);
        }
        if (sushiswapLiquidity >= uniswapLiquidity && sushiswapLiquidity >= inchLiquidity) {
            return address(sushiswapRouter);
        }
        if (inchLiquidity > 0) {
            return address(inchRouter);
        }
        return address(0); // Gibt Null-Adresse zurück, falls keine Liquidität vorhanden ist
    }

    function getAmountOutMinFrom1Inch(
        address tokenIn,
        address tokenOut,
        uint256 amount
    ) public view returns (uint256) {
        // Declare the path variable as an array of addresses
        address[] memory path = new address[](2);
        path[0] = tokenIn;
        path[1] = tokenOut;

        // Call the I1inchRouter to get the amounts out
        uint256[] memory amounts = I1inchRouter(inchRouter).getAmountsOut(tokenIn, amount, path);
        return amounts[1]; // Return the expected token amount
    }

    function isProfitableArbitrage(address tokenIn, address tokenOut, uint256 amount) private view returns (bool) {
        uint256 uniswapOut = getAmountOutMin(tokenIn, tokenOut, amount, uniswapRouter);
        uint256 sushiswapOut = getAmountOutMin(tokenIn, tokenOut, amount, sushiswapRouter);
        uint256 inchOut = getAmountOutMinFrom1Inch(tokenIn, tokenOut, amount);

        uint256 bestOut = uniswapOut > sushiswapOut ? uniswapOut : sushiswapOut;
        bestOut = bestOut > inchOut ? bestOut : inchOut;

        // ? Berechne den erwarteten Profit
        uint256 profit = bestOut > amount ? bestOut - amount : 0;

        // ? Schätzung der Gas-Kosten in ETH (z. B. 0.0005 ETH pro Swap)
        uint256 gasCost = tx.gasprice * gasleft();
        require(profit > gasCost, "Profit ist zu niedrig nach Gas-Kosten!");

        // ? Konvertiere Gas-Kosten in die gleiche Währung wie der Profit
        uint256 estimatedGasFee = tx.gasprice * gasleft();
        uint256 estimatedGasInToken = (estimatedGasFee * bestOut) / amount;

        // ? Stelle sicher, dass der Profit die Gas-Kosten übersteigt
        uint256 adjustedBestOut = bestOut * (100 - slippageTolerance) / 100;
        return adjustedBestOut > amount + estimatedGasInToken;

    }

}
