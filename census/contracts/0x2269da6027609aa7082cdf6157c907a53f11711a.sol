import {ISignatureTransfer} from "@uniswap/permit2/src/interfaces/ISignatureTransfer.sol";

interface IGiftEscrow {
    enum GiftStatus {
        Pending,
        Accepted,
        Sold,
        Expired
    }

    struct Gift {
        address gifter;
        address receiver;
        address giftToken;
        uint256 usdcAmount;
        uint256 expiration;
        GiftStatus status;
        ISignatureTransfer.PermitTransferFrom permit;
        bytes signature;
    }

    // Events
    event GiftSent(
        bytes32 indexed giftId,
        address indexed gifter,
        address indexed receiver,
        address giftEscrow,
        uint256 usdcAmount,
        uint256 expiration
    );

    event GiftAccepted(
        bytes32 indexed giftId,
        address indexed receiver,
        address giftEscrow,
        uint256 giftEscrowAmount,
        uint256 remainingUsdc
    );

    event GiftSold(
        bytes32 indexed giftId,
        address indexed receiver,
        address giftEscrow,
        uint256 giftEscrowAmount,
        uint256 usdcAmount
    );

    event GiftTokenAdded(address indexed token);
    event GiftTokenRemoved(address indexed token);

    // Errors
    error GiftAlreadyExists();
    error GiftNotFound();
    error InvalidGiftEscrow();
    error GiftExpired();
    error UnauthorizedReceiver();
    error InvalidGiftStatus();
    error InvalidPermitToken();

    // Constants
    function ADMIN_ROLE() external view returns (bytes32);
    function USDC() external view returns (address);
    function PERMIT2() external view returns (address);
    function SWAP_ROUTER() external view returns (address);

    // Mappings
    function gifts(bytes32 giftId)
        external
        view
        returns (
            address gifter,
            address receiver,
            address giftEscrow,
            uint256 usdcAmount,
            uint256 expiration,
            GiftStatus status,
            ISignatureTransfer.PermitTransferFrom memory permit,
            bytes memory signature
        );

    function allowedGiftTokens(address token) external view returns (bool);

    // Admin functions
    function addGiftToken(address token) external;
    function removeGiftToken(address token) external;

    // Core functions
    function sendGift(
        bytes32 giftId,
        address receiver,
        address giftEscrow,
        uint256 expiration,
        ISignatureTransfer.PermitTransferFrom memory permit,
        bytes memory signature
    ) external;

    function acceptGift(bytes32 giftId, uint24 poolFee) external;

    function sellGift(bytes32 giftId, uint256 giftEscrowAmount, uint24 poolFee) external;

    // View functions
    function getGiftsByGifter(address gifter) external view returns (bytes32[] memory);
    function getGiftsByReceiver(address receiver) external view returns (bytes32[] memory);
}

