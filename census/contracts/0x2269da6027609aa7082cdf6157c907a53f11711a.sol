// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {ISwapRouter} from "@uniswap/v3-periphery/contracts/interfaces/ISwapRouter.sol";
import {ISignatureTransfer} from "@uniswap/permit2/src/interfaces/ISignatureTransfer.sol";
import {IGiftEscrow} from "./IGiftEscrow.sol";

contract GiftEscrow is IGiftEscrow, AccessControl {
    using SafeERC20 for IERC20;

    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");

    address public immutable USDC;
    address public immutable PERMIT2;
    address public immutable SWAP_ROUTER;

    mapping(bytes32 => Gift) public gifts;
    mapping(address => bool) public allowedGiftTokens;
    mapping(address => bytes32[]) private _giftsByGifter;
    mapping(address => bytes32[]) private _giftsByReceiver;

    constructor(address _usdc, address _permit2, address _swapRouter) {
        USDC = _usdc;
        PERMIT2 = _permit2;
        SWAP_ROUTER = _swapRouter;

        _grantRole(DEFAULT_ADMIN_ROLE, msg.sender);
        _grantRole(ADMIN_ROLE, msg.sender);
    }

    function addGiftToken(address token) external onlyRole(ADMIN_ROLE) {
        allowedGiftTokens[token] = true;
        emit GiftTokenAdded(token);
    }

    function removeGiftToken(address token) external onlyRole(ADMIN_ROLE) {
        allowedGiftTokens[token] = false;
        emit GiftTokenRemoved(token);
    }

    function sendGift(
        bytes32 giftId,
        address receiver,
        address giftToken,
        uint256 expiration,
        ISignatureTransfer.PermitTransferFrom memory permit,
        bytes memory signature
    ) external {
        if (gifts[giftId].gifter != address(0)) revert GiftAlreadyExists();
        if (!allowedGiftTokens[giftToken]) revert InvalidGiftEscrow();
        if (permit.permitted.token != USDC) revert InvalidPermitToken();
        if (permit.deadline != expiration) revert GiftExpired();

        gifts[giftId] = Gift({
            gifter: msg.sender,
            receiver: receiver,
            giftToken: giftToken,
            usdcAmount: permit.permitted.amount,
            expiration: expiration,
            status: GiftStatus.Pending,
            permit: permit,
            signature: signature
        });

        _giftsByGifter[msg.sender].push(giftId);
        _giftsByReceiver[receiver].push(giftId);

        emit GiftSent(giftId, msg.sender, receiver, giftToken, permit.permitted.amount, expiration);
    }

    function acceptGift(bytes32 giftId, uint24 poolFee) external {
        Gift storage gift = gifts[giftId];

        if (gift.gifter == address(0)) revert GiftNotFound();
        if (msg.sender != gift.receiver) revert UnauthorizedReceiver();
        if (block.timestamp > gift.expiration) revert GiftExpired();
        if (gift.status != GiftStatus.Pending) revert InvalidGiftStatus();

        ISignatureTransfer.SignatureTransferDetails memory transferDetails =
            ISignatureTransfer.SignatureTransferDetails({to: address(this), requestedAmount: gift.usdcAmount});

        // Use permitTransferFrom to transfer USDC from gifter to contract
        ISignatureTransfer(PERMIT2).permitTransferFrom(gift.permit, transferDetails, gift.gifter, gift.signature);

        uint256 usdcBalance = IERC20(USDC).balanceOf(address(this));

        IERC20(USDC).forceApprove(SWAP_ROUTER, usdcBalance);

        ISwapRouter.ExactInputSingleParams memory params = ISwapRouter.ExactInputSingleParams({
            tokenIn: USDC,
            tokenOut: gift.giftToken,
            fee: poolFee,
            recipient: address(this),
            deadline: block.timestamp,
            amountIn: usdcBalance,
            amountOutMinimum: 0,
            sqrtPriceLimitX96: 0
        });

        uint256 giftEscrowAmount = ISwapRouter(SWAP_ROUTER).exactInputSingle(params);

        IERC20(gift.giftToken).safeTransfer(msg.sender, giftEscrowAmount);

        uint256 remainingUsdc = IERC20(USDC).balanceOf(address(this));
        if (remainingUsdc > 0) {
            IERC20(USDC).safeTransfer(msg.sender, remainingUsdc);
        }

        gift.status = GiftStatus.Accepted;

        emit GiftAccepted(giftId, msg.sender, gift.giftToken, giftEscrowAmount, remainingUsdc);
    }

    function sellGift(bytes32 giftId, uint256 giftEscrowAmount, uint24 poolFee) external {
        Gift storage gift = gifts[giftId];

        if (gift.gifter == address(0)) revert GiftNotFound();
        if (msg.sender != gift.receiver) revert UnauthorizedReceiver();
        if (gift.status != GiftStatus.Accepted) revert InvalidGiftStatus();

        IERC20(gift.giftToken).safeTransferFrom(msg.sender, address(this), giftEscrowAmount);

        IERC20(gift.giftToken).forceApprove(SWAP_ROUTER, giftEscrowAmount);

        ISwapRouter.ExactInputSingleParams memory params = ISwapRouter.ExactInputSingleParams({
            tokenIn: gift.giftToken,
            tokenOut: USDC,
            fee: poolFee,
            recipient: msg.sender,
            deadline: block.timestamp,
            amountIn: giftEscrowAmount,
            amountOutMinimum: 0,
            sqrtPriceLimitX96: 0
        });

        uint256 usdcAmount = ISwapRouter(SWAP_ROUTER).exactInputSingle(params);

        gift.status = GiftStatus.Sold;

        emit GiftSold(giftId, msg.sender, gift.giftToken, giftEscrowAmount, usdcAmount);
    }

    function getGiftsByGifter(address gifter) external view returns (bytes32[] memory) {
        return _giftsByGifter[gifter];
    }

    function getGiftsByReceiver(address receiver) external view returns (bytes32[] memory) {
        return _giftsByReceiver[receiver];
    }
}

