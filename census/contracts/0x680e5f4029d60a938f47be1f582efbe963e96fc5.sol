// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "@openzeppelin-contracts/token/ERC721/IERC721.sol";
import "@openzeppelin-contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin-contracts/utils/Address.sol";
import "@openzeppelin-contracts/access/Ownable.sol";
import "@openzeppelin-contracts/utils/cryptography/MerkleProof.sol";
import "./interface/INFToken.sol";

contract NFTokenMinter is ReentrancyGuard, Ownable {
    using Address for address;

    struct EventInfo {
        mapping(string => bytes32) merkleRoots; // token type => merkle root
        mapping(address => bool) recieved;
        bool isActive;
    }

    address private serviceAddress;

    mapping(address => uint256) public proceedEvent;
    mapping(uint256 => EventInfo) public eventInfos;
    mapping(address => uint256) public genId;

    // area: event
    event SetMerkleRoot(
        uint256 eventId,
        address tokenCon,
        bytes32 root,
        string tokenType
    );
    event ClaimToken(uint256 eventId, address to, uint256 id);
    event SwitchEventStatus(uint256 eventId, bool isActive);
    event SetGenerateId(address tokenCon, uint256 id);
    event SetServiceWallet(address setAddress);

    constructor() Ownable(msg.sender) {
        setServiceWallet(msg.sender);
    }

    // area: view
    function isClaimable(
        address account,
        address tokenCon,
        bytes32[] calldata merkleProof,
        string calldata tokenType
    ) external view returns (bool) {
        uint256 eventId = proceedEvent[tokenCon];
        return _checkClaimable(eventId, account, merkleProof, tokenType);
    }

    function getServiceData(
        uint256 eventId,
        string calldata tokenType
    ) external view returns (bool serviceStatus, bytes32 merkleRoot) {
        serviceStatus = eventInfos[eventId].isActive;
        merkleRoot = eventInfos[eventId].merkleRoots[tokenType];
    }

    // area: modifier
    modifier onlyService() {
        require(msg.sender == serviceAddress, "This is service function");
        _;
    }

    // area: user
    function claimToken(
        address tokenCon,
        bytes32[] calldata merkleProof,
        string calldata tokenType
    ) external nonReentrant {
        uint256 eventId = proceedEvent[tokenCon];
        require(
            _checkClaimable(eventId, msg.sender, merkleProof, tokenType),
            "Can not claim"
        );

        uint256 id = ++genId[tokenCon];
        INFToken token = INFToken(tokenCon);
        token.mintToken(msg.sender, id, tokenType);
        _setRecieved(eventId, msg.sender);

        emit ClaimToken(eventId, msg.sender, id);
    }

    // area: only service
    function setMerkleRoot(
        uint256 eventId,
        address tokenCon,
        bytes32 root,
        string calldata tokenType
    ) public onlyService {
        proceedEvent[tokenCon] = eventId;
        eventInfos[eventId].merkleRoots[tokenType] = root;
        emit SetMerkleRoot(eventId, tokenCon, root, tokenType);
    }

    function switchEventStatus(uint256 eventId) public onlyService {
        eventInfos[eventId].isActive = !eventInfos[eventId].isActive;
        emit SwitchEventStatus(eventId, eventInfos[eventId].isActive);
    }

    function setGenId(address tokenCon, uint256 id) public onlyService {
        genId[tokenCon] = id;
        emit SetGenerateId(tokenCon, id);
    }

    // area: only owner
    function setServiceWallet(address setAddress) public onlyOwner {
        serviceAddress = setAddress;
        emit SetServiceWallet(setAddress);
    }

    // area: private
    function _checkClaimable(
        uint256 eventId,
        address claimer,
        bytes32[] calldata merkleProof,
        string calldata tokenType
    ) private view returns (bool) {
        EventInfo storage info = eventInfos[eventId];

        if (info.isActive && info.recieved[claimer] == false) {
            return
                MerkleProof.verify(
                    merkleProof,
                    info.merkleRoots[tokenType],
                    keccak256(abi.encodePacked(claimer))
                );
        } else {
            return false;
        }
    }

    function _setRecieved(uint256 eventId, address claimer) private {
        EventInfo storage info = eventInfos[eventId];
        info.recieved[claimer] = true;
    }
}

