pragma solidity ^0.8.29;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

interface IUniswapV2Router {
    function swapExactTokensForTokens(
        uint amountIn,
        uint amountOutMin,
        address[] calldata path,
        address to,
        uint deadline
    ) external returns (uint[] memory amounts);
}
interface IUniswapV3Router {
    struct ExactInputSingleParams {
        address tokenIn;
        address tokenOut;
        uint24 fee;
        address recipient;
        uint256 amountIn;
        uint256 amountOutMinimum;
        uint160 sqrtPriceLimitX96;
    }
    
    function exactInputSingle(ExactInputSingleParams calldata params) 
        external payable returns (uint256 amountOut);
}
interface IQuoterV2 {
    function quoteExactInputSingle(
        address tokenIn,
        address tokenOut,
        uint24 fee,
        uint256 amountIn,
        uint160 sqrtPriceLimitX96
    ) external returns (uint256 amountOut);
}
contract MAAT is ReentrancyGuard, Ownable {
    using SafeERC20 for IERC20;
    
    event SwapExecuted(address indexed swapTarget, address indexed token, uint256 amountIn, uint256 amountOut);
    event ArbitrageCompleted(address indexed token, uint256 profit);
    
    address public authorizedCaller;
    // Types de DEX supportés
    enum DexType { V2, V3 }
    constructor() Ownable(msg.sender) {}

    // ========================================================================
    // STRUCTURE POUR ARBITRAGE CIRCULAIRE A → B → A
    // ========================================================================
    struct CircularArbData {
        //INFO
        address tokenA;
        uint256 amountA;
        address tokenB;
        //SWAP A → B
        address swapTarget1;
        bytes data1;
        uint256 value1;
        // Swap 2: B → A
        address swapTarget2;
        DexType dexType2;
        uint24 fee2;           // Pour V3 uniquement
        address quoter2;
        uint256 slippage;  
        uint256 value2;   
    }

    // ========================================================================
    // FONCTION ARBITRAGE CIRCULAIRE
    // ========================================================================
    function CircularArb(CircularArbData calldata sd) external payable  nonReentrant onlyAuthorized returns (uint256 finalA)  {
        // 1. Vérifier l'ETH envoyé
        require(msg.value == sd.value1 + sd.value2, "Incorrect ETH amount");
        
        // 2. Prendre tokenA du caller
        IERC20(sd.tokenA).safeTransferFrom(msg.sender, address(this), sd.amountA);
        uint256 initialA = IERC20(sd.tokenA).balanceOf(address(this));
        require(initialA >= sd.amountA, "No token A received");
        // 3. Approuver et exécuter Swap 1: A → B
        IERC20(sd.tokenA).forceApprove(sd.swapTarget1, sd.amountA);
        (bool success1, ) = sd.swapTarget1.call{value: sd.value1}(sd.data1);
        require(success1, "Swap A to B failed");
        emit SwapExecuted(sd.swapTarget1, sd.tokenA, sd.amountA, 0);
        // 4. Vérifier qu'on a reçu du tokenB
        uint256 balanceB = IERC20(sd.tokenB).balanceOf(address(this));
        require(balanceB > 0, "No token B received from swap 1");
        IERC20(sd.tokenB).forceApprove(sd.swapTarget2, balanceB);
        // 5. Construire et exécuter Swap 2: B → A 
        uint256 amountOutSwap2 = _executeSwap2(sd, balanceB);
        emit SwapExecuted(sd.swapTarget2, sd.tokenB, balanceB, amountOutSwap2);              
        // 6. Vérifier le profit
        finalA = IERC20(sd.tokenA).balanceOf(address(this));
        require(finalA > initialA, "No profit - finalA <= initialA");
        
        uint256 profit = finalA - initialA;
        emit ArbitrageCompleted(sd.tokenA, profit);
        
        // 7. Renvoyer tous les tokens au caller
        IERC20(sd.tokenA).safeTransfer(msg.sender, finalA);
        
        // 8. Renvoyer le tokenB restant (au cas où)
        uint256 remainingB = IERC20(sd.tokenB).balanceOf(address(this));
        if (remainingB > 0) {
            IERC20(sd.tokenB).safeTransfer(msg.sender, remainingB);
        }
        
        // 9. Nettoyer les allowances
        IERC20(sd.tokenA).forceApprove(sd.swapTarget1, 0);
        IERC20(sd.tokenB).forceApprove(sd.swapTarget2, 0);
        
        // 10. Renvoyer l'ETH restant
        uint256 leftover = address(this).balance;
        if (leftover > 0) {
            payable(msg.sender).transfer(leftover);
        }
        
        return finalA;
    }

       // ========================================================================
    // FONCTION INTERNE: EXÉCUTION DE SWAP 2 (B → A)
    // ========================================================================
    function _executeSwap2(CircularArbData calldata sd, uint256 balanceB) internal returns (uint256 amountOut) 
    {
        // Approuver le router pour tokenB
        IERC20(sd.tokenB).forceApprove(sd.swapTarget2, balanceB);
        
        if (sd.dexType2 == DexType.V2) {
            amountOut = _executeV2Swap(
                sd.swapTarget2,
                sd.tokenB,
                sd.tokenA,
                balanceB,
                sd.slippage,
                sd.value2
            );
        } 
        else if (sd.dexType2 == DexType.V3) {
            amountOut = _executeV3Swap(
                sd.swapTarget2,
                sd.tokenB,
                sd.tokenA,
                balanceB,
                sd.fee2,
                sd.quoter2,
                sd.slippage,
                sd.value2
            );
        } 
        else {
            revert("Unsupported DEX type");
        }
        
        return amountOut;
    }
    
    // ========================================================================
    // SWAP V2: Utilise la formule x*y=k pour calculer amountOutMin
    // ========================================================================
    function _executeV2Swap(address router,address tokenIn,address tokenOut,uint256 amountIn,uint256 slippage,uint256 value) internal returns (uint256) {
        // Pour V2, on calcule amountOutMin avec slippage
        // Note: Ce calcul est simplifié. Dans un cas réel, tu devrais
        // interroger les réserves du pool pour un calcul précis.
        
        // amountOutMin = 0 pour simplifier (ou tu peux passer un calcul JS)
        uint256 amountOutMin = 0;
        
        address[] memory path = new address[](2);
        path[0] = tokenIn;
        path[1] = tokenOut;
        
        uint256 deadline = block.timestamp + 300; // 5 minutes
        
        uint[] memory amounts = IUniswapV2Router(router).swapExactTokensForTokens(
            amountIn,
            amountOutMin,
            path,
            address(this),
            deadline
        );
        
        return amounts[amounts.length - 1];
    }
    
    // ========================================================================
    // SWAP V3: Utilise le Quoter pour calculer amountOutMin précis
    // ========================================================================
    function _executeV3Swap(address router,address tokenIn,address tokenOut,uint256 amountIn,uint24 fee,address quoter,uint256 slippage,uint256 value) internal returns (uint256) {
        uint256 amountOutMin = 0;
        
        // Utiliser le quoter si fourni
        if (quoter != address(0)) {
            try IQuoterV2(quoter).quoteExactInputSingle(
                tokenIn,
                tokenOut,
                fee,
                amountIn,
                0 // sqrtPriceLimitX96 = 0
            ) returns (uint256 quotedAmount) {
                // ✅ Appliquer slippage en décimal
                // slippage avec 4 décimales: 100 = 1%, 10 = 0.1%, 1 = 0.01%
                // Formule: amountOut * (10000 - slippage) / 10000
                amountOutMin = (quotedAmount * (10000 - slippage)) / 10000;
            } catch {
                // Si le quoter échoue, utiliser amountOutMin = 0
                amountOutMin = 0;
            }
        }
        
        // Construire les paramètres du swap V3
        IUniswapV3Router.ExactInputSingleParams memory params = IUniswapV3Router.ExactInputSingleParams({
            tokenIn: tokenIn,
            tokenOut: tokenOut,
            fee: fee,
            recipient: address(this),
            amountIn: amountIn,
            amountOutMinimum: amountOutMin,
            sqrtPriceLimitX96: 0
        });
        
        // Exécuter le swap
        return IUniswapV3Router(router).exactInputSingle{value: value}(params);
    }

  

    // ========================================================================
    // MODIFICATEURS ET FONCTIONS UTILITAIRES
    // ========================================================================
    modifier onlyAuthorized() {
        require(msg.sender == authorizedCaller || msg.sender == owner(), "Not authorized");
        _;
    }

    function setAuthorizedCaller(address _caller) external onlyOwner {
        authorizedCaller = _caller;
    }

    function depositToken(address token, uint256 amount) external nonReentrant onlyOwner {
        require(amount > 0, "Amount must be > 0");
        IERC20(token).safeTransferFrom(msg.sender, address(this), amount);
    }

    function withdrawToken(address token, address to) external nonReentrant onlyOwner {
        uint256 bal = IERC20(token).balanceOf(address(this));
        require(bal > 0, "No tokens");
        IERC20(token).safeTransfer(to, bal);
    }

    function getTokenBalance(address token, address account) public view returns (uint256) {
        return IERC20(token).balanceOf(account);
    }

    receive() external payable {}
    fallback() external payable {}
}
