     */
    modifier nonReentrant() {
        _nonReentrantBefore();
        _;
        _nonReentrantAfter();
    }

    function _nonReentrantBefore() private {
        // On the first call to nonReentrant, _status will be NOT_ENTERED
        if (_status == ENTERED) {
            revert ReentrancyGuardReentrantCall();
        }

        // Any calls to nonReentrant after this point will fail
        _status = ENTERED;
    }

    function _nonReentrantAfter() private {
        // By storing the original value once again, a refund is triggered (see
        // https://eips.ethereum.org/EIPS/eip-2200)
        _status = NOT_ENTERED;
    }

    /**
     * @dev Returns true if the reentrancy guard is currently set to "entered", which indicates there is a
     * `nonReentrant` function in the call stack.
     */
    function _reentrancyGuardEntered() internal view returns (bool) {
        return _status == ENTERED;
    }
}

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC721/IERC721.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC1155/IERC1155.sol";
import "@openzeppelin/contracts/token/ERC1155/utils/ERC1155Holder.sol";

/**
 * @title DCCLocker
 * @author TCG Team
 * @notice Contract for locking DCC NFTs with region and tier-based logic
 * @dev Handles deposit and withdrawal of DCC tokens with admin-controlled release
 */
contract DCCLocker is
    Ownable,
    ReentrancyGuard,
    Pausable,
    ERC1155Holder
{
    /// @notice The DCC NFT contract
    IERC721 private _dcc;

    /// @notice Track lock status of DCC token ids
    /// @dev mapping(tokenId => isLocked)
    mapping(uint256 => bool) private _locked;

    /// @notice Track count of locked tokens per user
    /// @dev mapping(userAddress => lockCount)
    mapping(address => uint256) private _userLockCount;

    /// @notice Track which user locked each token
    /// @dev mapping(tokenId => originalOwner)
    mapping(uint256 => address) private _tokenOwner;

    /// @notice Emitted when DCC tokens are deposited
    /// @param user Address that deposited the tokens
    /// @param dccTokenIds Array of token IDs deposited
    /// @param region Region identifier (0-8, where 0 may indicate individual)
    /// @param targetTier Target tier level (1-5, where 5 is Mythic)
    /// @param family Whether this is a family deposit
    /// @param nonce Unique nonce for the deposit transaction
    event DCCDeposited(
        address indexed user,
        uint256[] dccTokenIds,
        uint8 region,
        uint8 targetTier,
        bool family,
        uint256 nonce
    );

    /// @notice Emitted when DCC tokens are withdrawn
    /// @param to Recipient address
    /// @param dccTokenIds Array of token IDs withdrawn
    event DCCWithdrawn(address indexed to, uint256[] dccTokenIds);

    /// @notice Emitted when DCC contract address is updated
    /// @param oldAddress Previous DCC contract address
    /// @param newAddress New DCC contract address
    event DCCAddressUpdated(address indexed oldAddress, address indexed newAddress);

    /// @notice Emitted when ETH is withdrawn by owner
    /// @param to Recipient address
    /// @param amount Amount withdrawn
    event EmergencyETHWithdrawn(address indexed to, uint256 amount);

    /// @notice Emitted when ERC20 tokens are withdrawn by owner
    /// @param token Token address
    /// @param to Recipient address
    /// @param amount Amount withdrawn
    event EmergencyERC20Withdrawn(address indexed token, address indexed to, uint256 amount);

    /// @notice Emitted when ERC721 tokens are withdrawn by owner
    /// @param token NFT contract address
    /// @param to Recipient address
    /// @param tokenId Token ID withdrawn
    event EmergencyERC721Withdrawn(address indexed token, address indexed to, uint256 tokenId);

    /// @notice Emitted when ERC1155 tokens are withdrawn by owner
    /// @param token Token contract address
    /// @param to Recipient address
    /// @param id Token ID
    /// @param amount Amount withdrawn
    event EmergencyERC1155Withdrawn(address indexed token, address indexed to, uint256 id, uint256 amount);

    /**
     * @notice Initializes the DCC locker contract
     * @param dccAddress Address of the DCC NFT contract
     */
    constructor(address dccAddress) Ownable(msg.sender) {
        require(dccAddress != address(0), "Invalid DCC address");
        _dcc = IERC721(dccAddress);
    }


    /**
     * @notice Returns the DCC NFT contract address
     * @return The DCC NFT contract
     */
    function dcc() public view returns (IERC721) {
        return _dcc;
    }

    /**
     * @notice Returns lock status of a token
     * @param tokenId Token ID to check
     * @return True if locked, false otherwise
     */
    function locked(uint256 tokenId) public view returns (bool) {
        return _locked[tokenId];
    }

    /**
     * @notice Returns the count of locked tokens for a user
     * @param user User address
     * @return Count of locked tokens
     */
    function userLockCount(address user) public view returns (uint256) {
        return _userLockCount[user];
    }

    /**
     * @notice Returns the original owner of a locked token
     * @param tokenId Token ID
     * @return Original owner address
     */
    function tokenOwner(uint256 tokenId) public view returns (address) {
        return _tokenOwner[tokenId];
    }

    /**
     * @notice Updates the DCC NFT contract address
     * @dev Only callable by owner, be careful when changing as it affects all operations
     * @param newDCCAddress New DCC NFT contract address
     */
    function setDCCAddress(address newDCCAddress) external onlyOwner {
        require(newDCCAddress != address(0), "Invalid DCC address");

        address oldAddress = address(_dcc);
        _dcc = IERC721(newDCCAddress);

        emit DCCAddressUpdated(oldAddress, newDCCAddress);
    }

    /**
     * @notice Pauses all deposit and withdrawal operations
     * @dev Only callable by owner
     */
    function pause() external onlyOwner {
        _pause();
    }

    /**
     * @notice Unpauses deposit and withdrawal operations
     * @dev Only callable by owner
     */
    function unpause() external onlyOwner {
        _unpause();
    }

    /**
     * @notice Deposits DCC tokens into the locker
     * @dev Transfers tokens from sender and locks them
     * @param dccTokenIds Array of DCC token IDs to deposit
     * @param region Region identifier (0-8)
     * @param targetTier Target tier (1-5, where 5 is Mythic)
     * @param family Whether this is a family deposit
     * @param nonce Unique nonce for tracking
     */
    function deposit(
        uint256[] calldata dccTokenIds,
        uint8 region,
        uint8 targetTier,
        bool family,
        uint256 nonce
    ) external whenNotPaused nonReentrant {
        require(dccTokenIds.length > 0, "No token IDs provided");
        require(targetTier >= 1 && targetTier <= 5, "Invalid tier (must be 1-5)");
        require(region <= 8, "Invalid region (must be 0-8)");

        for (uint256 i = 0; i < dccTokenIds.length; i++) {
            uint256 id = dccTokenIds[i];
            require(!_locked[id], "Token already locked");

            _dcc.transferFrom(msg.sender, address(this), id);
            _locked[id] = true;
            _tokenOwner[id] = msg.sender;
        }

        unchecked {
            _userLockCount[msg.sender] += dccTokenIds.length;
        }

        emit DCCDeposited(msg.sender, dccTokenIds, region, targetTier, family, nonce);
    }

    /**
     * @notice Withdraws DCC tokens from the locker
     * @dev Users can withdraw their own locked tokens
     * @param to Recipient address
     * @param dccTokenIds Array of DCC token IDs to withdraw
     */
    function withdraw(address to, uint256[] calldata dccTokenIds) external nonReentrant {
        require(to != address(0), "Invalid recipient address");
        require(dccTokenIds.length > 0, "No token IDs provided");

        for (uint256 i = 0; i < dccTokenIds.length; i++) {
            uint256 id = dccTokenIds[i];
            require(_locked[id], "Token not locked");

            address originalOwner = _tokenOwner[id];
            require(originalOwner == msg.sender, "Not token owner");

            if (originalOwner != address(0) && _userLockCount[originalOwner] > 0) {
                unchecked {
                    _userLockCount[originalOwner]--;
                }
            }

            _locked[id] = false;
            _tokenOwner[id] = address(0);
            _dcc.transferFrom(address(this), to, id);
        }

        emit DCCWithdrawn(to, dccTokenIds);
    }

    /**
     * @notice Batch withdraw multiple users' tokens (admin only)
     * @dev Allows efficient withdrawal to multiple recipients
     * @param recipients Array of recipient addresses
     * @param tokenIdBatches 2D array of token IDs for each recipient
     */
    function batchWithdraw(
        address[] calldata recipients,
        uint256[][] calldata tokenIdBatches
    ) external onlyOwner nonReentrant {
        require(recipients.length == tokenIdBatches.length, "Array length mismatch");

        for (uint256 i = 0; i < recipients.length; i++) {
            address to = recipients[i];
            uint256[] calldata dccTokenIds = tokenIdBatches[i];

            require(to != address(0), "Invalid recipient address");
            require(dccTokenIds.length > 0, "No token IDs provided");

            for (uint256 j = 0; j < dccTokenIds.length; j++) {
                uint256 id = dccTokenIds[j];
                require(_locked[id], "Token not locked");

                address originalOwner = _tokenOwner[id];
                if (originalOwner != address(0) && _userLockCount[originalOwner] > 0) {
                    unchecked {
                        _userLockCount[originalOwner]--;
                    }
                }

                _locked[id] = false;
                _tokenOwner[id] = address(0);
                _dcc.transferFrom(address(this), to, id);
            }

            emit DCCWithdrawn(to, dccTokenIds);
        }
    }

    /**
     * @notice Gets the lock status of multiple tokens
     * @param tokenIds Array of token IDs to check
     * @return statuses Array of lock statuses
     */
    function getLockStatuses(uint256[] calldata tokenIds) external view returns (bool[] memory statuses) {
        statuses = new bool[](tokenIds.length);
        for (uint256 i = 0; i < tokenIds.length; i++) {
            statuses[i] = _locked[tokenIds[i]];
        }
    }

    /**
     * @notice Emergency function to withdraw ETH
     * @dev Only callable by owner, used for recovery of stuck funds
     * @param to Recipient address
     * @param amount Amount to withdraw
     */
    function emergencyWithdrawETH(address payable to, uint256 amount) external onlyOwner {
        require(to != address(0), "Invalid recipient");
        require(amount > 0, "Invalid amount");
        require(address(this).balance >= amount, "Insufficient balance");

        (bool success, ) = to.call{value: amount}("");
        require(success, "ETH transfer failed");

        emit EmergencyETHWithdrawn(to, amount);
    }

    /**
     * @notice Emergency function to withdraw ERC20 tokens
     * @dev Only callable by owner, used for recovery of stuck tokens
     * @param token Token contract address
     * @param to Recipient address
     * @param amount Amount to withdraw
     */
    function emergencyWithdrawERC20(address token, address to, uint256 amount) external onlyOwner {
        require(token != address(0), "Invalid token");
        require(to != address(0), "Invalid recipient");
        require(amount > 0, "Invalid amount");

        IERC20(token).transfer(to, amount);
        emit EmergencyERC20Withdrawn(token, to, amount);
    }

    /**
     * @notice Emergency function to withdraw non-DCC ERC721 NFTs
     * @dev Only callable by owner, cannot withdraw locked DCC tokens
     * @param token NFT contract address
     * @param to Recipient address
     * @param tokenId Token ID to withdraw
     */
    function emergencyWithdrawERC721(address token, address to, uint256 tokenId) external onlyOwner {
        require(token != address(0), "Invalid token");
        require(to != address(0), "Invalid recipient");

        if (token == address(_dcc)) {
            require(!_locked[tokenId], "Cannot emergency withdraw locked DCC");
        }

        IERC721(token).transferFrom(address(this), to, tokenId);
        emit EmergencyERC721Withdrawn(token, to, tokenId);
    }

    /**
     * @notice Emergency function to withdraw ERC1155 tokens
     * @dev Only callable by owner, used for recovery of stuck tokens
     * @param token Token contract address
     * @param to Recipient address
     * @param id Token ID
     * @param amount Amount to withdraw
     */
    function emergencyWithdrawERC1155(address token, address to, uint256 id, uint256 amount) external onlyOwner {
        require(token != address(0), "Invalid token");
        require(to != address(0), "Invalid recipient");
        require(amount > 0, "Invalid amount");

        IERC1155(token).safeTransferFrom(address(this), to, id, amount, "");
        emit EmergencyERC1155Withdrawn(token, to, id, amount);
    }

    /**
     * @notice Allows contract to receive ETH
     */
    receive() external payable {}
}