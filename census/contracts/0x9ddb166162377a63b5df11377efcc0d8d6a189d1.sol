/// @notice Type of the auction
/// SellerSelection: The seller selects the winning bid
enum AuctionType {
    SellerSelection
}

/// @notice Status of a current listing
/// NonExistent: The listing does not exist, to make sure default value does not map to anything meaningful
/// Active: The listing is active.
/// Note that this does not necessarily mean that the listing can receive bids
/// In cases where there is an end date, the listing can still be active (until explicitly ended)
/// but not accept bids anymore
/// Canceled: The listing has been canceled
/// Executed: The listing has been executed
enum ListingStatus {
    NonExistent,
    Active,
    Cancelled,
    Executed
}

/// @notice Uniquely identifies an NFT
struct Nft {
    address collection;
    uint256 id;
}

/// @notice Request to list an NFT
/// This is the data type used to receive listing requests from users
struct ListingRequest {
    Nft nft;
    AuctionType auctionType;
    bytes parameters;
}

/// @notice Represents a listing
/// This data type is immutable and will not change after having been created
/// `parameters` represents the auction type-specific data
/// and it is up to the `IAuction` implementations to use this data
struct Listing {
    uint64 id;
    Nft nft;
    AuctionType auctionType;
    bytes parameters;
    address seller;
}

/// @notice Represents the state of a listing
/// This data type is mutable and will change as the listing progresses
/// `content` represents the auction type-specific state data
struct ListingState {
    ListingStatus status;
    bytes content;
}

/// @notice Metadata used to create a valid permit2 request
struct PermitMeta {
    uint256 nonce;
    uint256 deadline;
    bytes signature;
}

/// @notice Represents a user share in a group
/// @param share is a number between 0 and 1 scaled to 18 decimals
struct UserShare {
    address user;
    uint64 share;
}

/// @notice Represenets a user and an arbitrary amount (typically of tokens)
struct UserAmount {
    address user;
    uint96 amount;
}

