pragma solidity ^0.8.24;

import {IAddressProvider} from "@/interfaces/IAddressProvider.sol";
import {Errors} from "@/libraries/Errors.sol";

contract SquadOwnableUpgradeable {
    IAddressProvider public addressProvider;

    modifier onlyOwner() {
        if (msg.sender != addressProvider.owner()) revert Errors.NotAuthorized(msg.sender);
        _;
    }

    function __SquadOwnableUpgradeable_init(IAddressProvider _addressProvider) internal {
        addressProvider = _addressProvider;
    }
}

