pragma solidity ^0.8.24;

interface IAddressProvider {
    event AddressSet(bytes32 indexed name, address value);
    event AddressFrozen(bytes32 indexed name);

    /// @notice Sets the address for the given key
    function set(bytes32 key, address value) external;

    /// @notice Freezes the address for the given key, preventing further changes
    function freeze(bytes32 name) external;

    /// @notice Gets the address for the given key
    function get(bytes32 name) external view returns (address);

    /// @notice Checks if the address for the given key is frozen
    function isFrozen(bytes32 name) external view returns (bool);

    /// @notice Gets the owner of the contract
    /// Note that this owner will be used by all contracts relying on `SquadOwnable`
    function owner() external view returns (address);
}

// SPDX-License-Identifier: GPL-3.0-or-later
pragma solidity ^0.8.24;

interface IRoleManager {
    event WhitelistChanged(address indexed creator, bool value);
    event GatekeeperChanged(address indexed creator, bool value);

    /// @notice Adds or removes an address from the whitelist
    function setCreator(address creator, bool value) external;
    /// @notice Adds or removes multiple addresses from the whitelist
    function setCreatorBatch(address[] calldata creators, bool[] calldata values) external;
    /// @notice Adjusts the whether an address is allowed to set creators
    function setGatekeeper(address user, bool value) external;

    /// @notice Returns true if the the address is a whitelisted creator
    function creatorWhitelisted(address) external view returns (bool);

    /// @notice Returns the list of gatekeepers
    function listGatekeepers() external view returns (address[] memory);
}

