// SPDX-License-Identifier: GPL-3.0-or-later
pragma solidity ^0.8.24;

import {UUPSUpgradeable} from "ozu/proxy/utils/UUPSUpgradeable.sol";
import {SquadOwnableUpgradeable} from "@/access/SquadOwnableUpgradeable.sol";
import {IAddressProvider} from "@/interfaces/IAddressProvider.sol";
import {IRoleManager} from "@/interfaces/IRoleManager.sol";
import {AddressProviderHelper} from "@/libraries/AddressProviderHelper.sol";
import {Errors} from "@/libraries/Errors.sol";
import {EnumerableSet} from "oz/utils/structs/EnumerableSet.sol";

contract RoleManager is IRoleManager, SquadOwnableUpgradeable, UUPSUpgradeable {
    using AddressProviderHelper for IAddressProvider;
    using EnumerableSet for EnumerableSet.AddressSet;

    EnumerableSet.AddressSet internal _allowedCreators;
    EnumerableSet.AddressSet internal _gatekeepers;

    constructor() {
        _disableInitializers();
    }

    function initialize(IAddressProvider addressProvider_) external initializer {
        __UUPSUpgradeable_init();
        __SquadOwnableUpgradeable_init(addressProvider_);
    }

    function _authorizeUpgrade(address newImplementation) internal virtual override onlyOwner {}

    // @inheritdoc IRoleManager
    function setCreator(address creator, bool value) public onlyGatekeeper {
        if (value) {
            if (!_allowedCreators.add(creator)) revert Errors.AlreadyWhitelisted(creator);
        } else {
            if (!_allowedCreators.remove(creator)) revert Errors.NotWhitelisted(creator);
        }
        emit WhitelistChanged(creator, value);
    }

    // @inheritdoc IRoleManager
    function setCreatorBatch(address[] calldata creators, bool[] calldata values) external onlyGatekeeper {
        if (creators.length != values.length) revert Errors.InvalidLength(creators.length, values.length);
        for (uint256 i = 0; i < creators.length; i++) {
            bool didChange = false;
            if (values[i]) {
                didChange = _allowedCreators.add(creators[i]);
            } else {
                didChange = _allowedCreators.remove(creators[i]);
            }
            if (didChange) {
                emit WhitelistChanged(creators[i], values[i]);
            }
        }
    }

    // @inheritdoc IRoleManager
    function setGatekeeper(address user, bool value) external onlyOwner {
        if (value) {
            if (!_gatekeepers.add(user)) revert Errors.AlreadyGatekeeper(user);
        } else {
            if (!_gatekeepers.remove(user)) revert Errors.NotGatekeeper(user);
        }
        emit GatekeeperChanged(user, value);
    }

    // @inheritdoc IRoleManager
    function creatorWhitelisted(address creator) external view returns (bool) {
        return _allowedCreators.contains(creator);
    }

    // @inheritdoc IRoleManager
    function listGatekeepers() external view override returns (address[] memory) {
        return _gatekeepers.values();
    }

    modifier onlyGatekeeper() {
        if (!_gatekeepers.contains(msg.sender)) revert Errors.NotAuthorized(msg.sender);
        _;
    }
}

