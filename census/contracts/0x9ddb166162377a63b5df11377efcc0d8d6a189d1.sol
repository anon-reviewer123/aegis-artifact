    function leaveGroup() external;

    /// @notice returns whether the given address is a member of the group
    function isMember(address member) external view returns (bool);

    /// @notice Returns the members of the group
    function listMembers() external view returns (address[] memory);

    ///
    /// Director related functions
    ///

    /// @notice Returns the director of the group
    function director() external view returns (address);

    /// @notice Sets a new directory
    function setNewDirector(address newDirector) external;

    ///
    /// Collection related functions
    ///

    /// @notice Creates a new collection
    function createCollection(string memory name) external returns (IArtworkCollection);

    /// @notice Returns whether the given address is a collection of the group
    function isCollection(address collection) external view returns (bool);

    /// @notice Returns the collections of the group
    function listCollections() external view returns (address[] memory);

    ///
    /// Artwork related functions
    ///

    /// @notice Mints an artwork into `collection`
    /// Group must be the owner of the collection
    function mint(IArtworkCollection collection, string calldata uri, bytes calldata sharesCalculatorData)
        external
        returns (uint256);

    /// @notice Burns an artwork from `collection`
    /// Group must be the owner of the NFT
    function burn(IArtworkCollection collection, uint256 nftId) external;

    /// @notice Lists an artwork to the marketplace
    /// The artwork needs to exist and be owned by the group
    /// For more information reqgarding ListingRequest, see Marketplace
    function createListing(ListingRequest calldata request) external returns (uint64 listingId);

    /// @notice Cancels the given listing
    function cancelListing(uint64 listingId) external;

    /// @notice Execute the auction associated with the given listing ID
    /// See marketplace for more information about the data
    function executeAuction(uint64 listingId, bytes calldata data) external;
}

