    error InvalidDirector();
    error InvalidSharesCalculator(address sharesCalculator);

    // CreatorGroup errors
    error AlreadyInitialized();
    error MemberNotFound(address member);
    error MemberAlreadyAdded(address member);
    error MaxMembersPerGroupExceeded();
    error MaxCollectionsPerGroupExceeded();
    error CannotRemoveDirector();

    // Marketplace errors
    error AuctionTypeNotRegistered(AuctionType auctionType);
    error ListingIdNotFound(uint64 id);
    error ListingNotFound(address collection, uint256 nftId);
    error ListingNotActive(uint64 id);
    error NftAlreadyListed(address collection, uint256 id);
    error NotSupported(AuctionType auctionType, string action);
    error NotApproved(address collection, uint256 id, address spender);
    error InvalidBid(uint64 actual, uint64 expected);
    error InvalidOwner(address actual, address expected);
    error NotFromExistingGroup(address collection);

    // Fees distributor errors
    error InvalidSharesSum(uint256 sum);
    error NotEnoughToWithdraw(address account, uint256 requested, uint256 available);

    // SharesCalculator errors
    error InvalidDataLength(uint256 actualLength, uint256 expectedLength);
    error InvalidMembersInformation(address[] memebers);
    error StaleSignature();

    // RoleManager errors
    error AlreadyWhitelisted(address creator);
    error NotWhitelisted(address creator);
    error AlreadyGatekeeper(address creator);
    error NotGatekeeper(address creator);
    error InvalidLength(uint256 creatorLength, uint256 valueLength);
}

