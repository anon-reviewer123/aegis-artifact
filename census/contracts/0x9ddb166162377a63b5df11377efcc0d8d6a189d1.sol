pragma solidity ^0.8.24;

import {IERC20} from "oz/token/ERC20/IERC20.sol";

import {IArtworkCollection} from "@/interfaces/IArtworkCollection.sol";

import {UserShare} from "@/libraries/DataTypes.sol";

interface IFeesDistributor {
    /// @notice a struct representing a fee receiver
    struct FeeReceiver {
        address receiver;
        uint256 share;
    }

    /// @notice emitted when fees are received
    /// @param token the token that was received
    /// @param sender the address that sent the fees.
    /// If the sender is not known, which is the case for fees received from third-party markets
    /// then this will be the zero address
    /// @param amount the amount of fees that were received
    /// @param netAmount the amount of fees that will be distributed to the receivers
    event FeesReceived(address indexed token, address indexed sender, uint256 amount, uint256 netAmount);

    /// @notice emitted when a user withdraws fees
    /// @param token the token withdrawn
    /// @param account the account withdrawing the fees
    /// @param amount the amount withdrawn
    event Withdrawal(address indexed token, address indexed account, uint256 amount);

    /// @notice Initializes the fees distributor
    /// @param protocolShare_ the share of the protocol in the fees, scaled with 18 decimals
    /// @param receivers the receivers of the fees. The sum of the shares should be 1e18
    function initialize(
        IArtworkCollection collection_,
        uint256 nftId_,
        uint256 protocolShare_,
        UserShare[] memory receivers
    ) external;

    /// @notice allows to deposit fees to the contract
    /// when the fees have already been charged the amount that should go to the protocol
    /// This is only callable by the marketplace
    function depositAlreadyChargedFees(IERC20 token, uint256 amount) external;

    /// @notice this function should be called to process fees that have not been accounted for
    /// It will be called by the marketplace on secondary sales
    /// as well as by this contract when a user withdraws his fees
    /// It can be called by anyone, since it simply adjusts the internal accounting
    function processUnaccountedFees(IERC20 token) external;

    /// @notice Withdraws `amount` number of `token`
    /// The sender needs to have enough fees to withdraw, otherwise the function reverts
    function withdraw(IERC20 token, uint256 amount) external;

    /// @notice Withdraws `amount` number of `token` for `account`
    /// `msg.sender` must either be the account or the fee withdrawal zap
    function withdrawFor(IERC20 token, uint256 amount, address account) external;

    /// @notice Returns the share of the given `receiver`
    function getReceiverShare(address receiver) external view returns (uint256);

    /// @notice Returns the available amount to withdraw of `token` for `receiver`
    function getAvailableAmount(IERC20 token, address receiver) external view returns (uint256);

    /// @notice the collection that this fees distributor is associated with
    function collection() external view returns (IArtworkCollection);

    /// @notice the nft id that this fees distributor is associated with
    function nftId() external view returns (uint256);

    /// @notice the share of the protocol in the fees, scaled with 18 decimals
    /// e.g. if this is 50%, then the treasury will receive half of the fees received
    function protocolShare() external view returns (uint256);
}

