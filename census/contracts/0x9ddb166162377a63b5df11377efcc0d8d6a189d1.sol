pragma solidity ^0.8.24;

import {ListingRequest, Listing} from "@/libraries/DataTypes.sol";

interface IAuction {
    /// @notice Validates a listing about to be created
    /// This is called when a user tries to list an NFT
    /// @return initialState the initial state of the listing
    function validateListing(Listing calldata listing) external view returns (bytes memory initialState);

    /// @notice Processes a bid
    /// This is called using delegatecall so it can handle any transfers if needed
    /// @param bid is the data passed by the caller making the bid
    /// @return newState returns the content of the new state
    function processBid(Listing calldata listing, bytes calldata state, bytes calldata bid)
        external
        view
        returns (bytes memory newState);

    /// @notice Execute the auction, performing the sale
    /// This is called using delegatecall so it can handle any transfers if needed
    /// @param data is the data passed by the caller of the execute function
    /// The caller might be the seller, the buyer, or another party depending on the
    /// auction type
    /// @return buyer returns the buyer of the auction
    /// @return amount returns the amount for which the listing was sold
    /// @return newState returns the content of the new state
    function executeAuction(Listing calldata listing, bytes calldata state, bytes calldata data)
        external
        returns (address buyer, uint256 amount, bytes memory newState);
}

