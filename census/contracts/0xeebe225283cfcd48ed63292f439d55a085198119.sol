    ERC721A, 
    EIP712, 
    CustomOwnable, 
    ReentrancyGuardTransient 
{
    using Strings for uint256;

    // =============================================================
    //                            STRUCTS                           
    // =============================================================

    struct MintRequest {
        address buyer;
        uint256 quantity;
        uint256 nonce;
        uint256 expiry;
    }

    // =============================================================
    //                      CONSTANTS / STORAGE                     
    // =============================================================

    uint256 public immutable maxSupply;

    string public baseURI;
    string public contractURI;

    address private immutable _signer;
    mapping(uint256 => bool) private _usedNonces;

    bytes32 private constant MINT_REQUEST_TYPEHASH = keccak256("MintRequest(address buyer,uint256 quantity,uint256 nonce,uint256 expiry)");

    // =============================================================
    //                            ERRORS
    // =============================================================

    error ExceedsMaxSupply();
    error InvalidSignature();
    error TransferFailed();
    error NonceAlreadyUsed();
    error InvalidMaxSupply();
    error InvalidSigner();
    error SenderIsNotBuyer();
    error SignatureExpired();

    // =============================================================
    //                          CONSTRUCTOR                         
    // =============================================================

    /**
     * @notice UpbitErc721Contract 생성자
     * @param name_ NFT 컬렉션 이름
     * @param symbol_ NFT 컬렉션 심볼
     * @param maxSupply_ 최대 발행량
     * @param baseURI_ 베이스 토큰 URI
     * @param contractURI_ 컨트랙트 메타데이터 URI
     * @param signer_ EIP-712 서명 검증용 주소
    */
