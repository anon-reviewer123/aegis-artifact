pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "./interfaces/MarketParams.sol";
import "./interfaces/IMorpho.sol";
import "./interfaces/IMorphoCallbacks.sol";
import "./interfaces/IPendleRouter.sol";
import "./libraries/FlashLoanValidation.sol";
import {Id} from "./interfaces/IMorpho.sol";

/**
 * @title Pendle Flash Loan Callback
 * @notice Callback contract for executing Pendle swaps with flash loans
 * @dev Implements Pendle-specific strategy logic for both wind and unwind operations
 * 
 * Key Features:
 * - Stateless: No asset custody, only temporary execution
 * - Permissioned: Only Safe and FlashLoanModule can interact
 * - Modular: Focused on Pendle swap execution
 * - Secure: Inherits base security features
 * - No delegatecall: Direct function calls for safety
 * - Dual Mode: Supports both wind (leverage) and unwind (deleverage) operations
 */
contract PendleFlashLoanCallback is IMorphoFlashLoanCallback, ReentrancyGuard, AccessControl {
    using SafeERC20 for IERC20;
    using FlashLoanValidation for uint256;

    // Events
    event PendleOperationCompleted(
        address indexed token,
        uint256 amount,
        uint256 profit,
        bool isUnwind
    );

    // Errors
    error InvalidRouter();
    error InvalidOperation();
    error InvalidSwapData();
    error SlippageTooHigh();

    // State variables
    address public immutable flashLoanModule;
    address public immutable safe;
    IPendleRouter public immutable pendleRouter;

    /**
     * @dev Constructor initializes the callback contract
     * @param _flashLoanModule Address of the SafeFlashLoanModule
     * @param _safe Address of the Gnosis Safe
     * @param _pendleRouter Address of the Pendle Router
     */
    constructor(
        address _flashLoanModule,
        address _safe,
        address _pendleRouter
    ) {
        if (_flashLoanModule == address(0)) revert InvalidRouter();
        if (_safe == address(0)) revert InvalidRouter();
        if (_pendleRouter == address(0)) revert InvalidRouter();
        if (_pendleRouter.code.length == 0) revert InvalidRouter();
        
        flashLoanModule = _flashLoanModule;
        safe = _safe;
        pendleRouter = IPendleRouter(_pendleRouter);
        _grantRole(DEFAULT_ADMIN_ROLE, _safe);
    }

    /**
     * @dev Handles the flash loan callback from Morpho Protocol
     * @param amount The amount borrowed
     * @param data Encoded data containing operation parameters
     */
    function onMorphoFlashLoan(
        uint256 amount,
        bytes calldata data
    ) external override nonReentrant {
        if (msg.sender != flashLoanModule) revert InvalidRouter();
        if (amount == 0) revert InvalidOperation();
        
        // Decode only marketId (as Id), safeAddr, strategyData, isUnwind
        (Id marketId, address safeAddr, bytes memory strategyData, bool isUnwind) = abi.decode(data, (Id, address, bytes, bool));
        MarketParams memory marketParams = IMorpho(flashLoanModule).idToMarketParams(marketId);

        if (!isUnwind) {
            _wind(strategyData, amount, marketParams, safeAddr);
        } else {
            _unwind(strategyData, amount, marketParams, safeAddr);
        }
    }

    function _wind(
        bytes memory strategyData,
        uint256 amount,
        MarketParams memory marketParams,
        address safeAddr
    ) internal {
        // Decode swap parameters
        address tokenIn;
        address ptToken;
        address router;
        bytes memory swapCalldata;
        uint256 minOut;
        if (strategyData.length > 0) {
            (tokenIn, ptToken, router, swapCalldata, minOut) = abi.decode(strategyData, (address, address, address, bytes, uint256));
        } else {
            tokenIn = marketParams.loanToken;
            ptToken = marketParams.collateralToken;
            router = address(pendleRouter);
            swapCalldata = "";
            minOut = 0; // No slippage protection in default case
        }
        // 1. Approve and swap tokenIn -> PT
        IERC20(tokenIn).safeIncreaseAllowance(router, amount);
        (bool success, bytes memory result) = router.call(swapCalldata);
        require(success, "Pendle swap failed");
        uint256 amountPT = abi.decode(result, (uint256));

        // 2. Approve and supply PT as collateral for the Safe
        IERC20(ptToken).safeIncreaseAllowance(flashLoanModule, amountPT);
        IMorpho(flashLoanModule).supplyCollateral(marketParams, amountPT, safeAddr, "");

        // 3. Borrow tokenIn (USDC) for the Safe
        IMorpho(flashLoanModule).borrow(marketParams, amount, 0, safeAddr, safeAddr);

        // 4. Repay the flashloan
        IERC20(tokenIn).safeTransfer(flashLoanModule, amount);

        emit PendleOperationCompleted(tokenIn, amount, amountPT - amount, false);
    }

    function _unwind(
        bytes memory strategyData,
        uint256 amount,
        MarketParams memory marketParams,
        address safeAddr
    ) internal {
        // Decode swap parameters
        address tokenIn;
        address ptToken;
        address router;
        bytes memory swapCalldata;
        uint256 minOut;
        if (strategyData.length > 0) {
            (tokenIn, ptToken, router, swapCalldata, minOut) = abi.decode(strategyData, (address, address, address, bytes, uint256));
        } else {
            tokenIn = marketParams.loanToken;
            ptToken = marketParams.collateralToken;
            router = address(pendleRouter);
            swapCalldata = "";
            minOut = 0; // No slippage protection in default case
        }
        // 1. Withdraw PT collateral from Morpho for the Safe
        IMorpho(flashLoanModule).withdrawCollateral(marketParams, amount, safeAddr, address(this));

        // 2. Approve and swap PT -> USDC
        IERC20(tokenIn).safeIncreaseAllowance(router, amount);
        (bool success, bytes memory result) = router.call(swapCalldata);
        require(success, "Pendle swap failed");
        uint256 amountUSDC = abi.decode(result, (uint256));

        // 3. Repay USDC debt for the Safe
        IERC20(ptToken).safeIncreaseAllowance(flashLoanModule, amountUSDC);
        IMorpho(flashLoanModule).repay(marketParams, amountUSDC, 0, safeAddr, "");

        // 4. Repay the flashloan
        IERC20(tokenIn).safeTransfer(flashLoanModule, amount);

        emit PendleOperationCompleted(tokenIn, amount, amountUSDC - amount, true);
    }

    /**
     * @dev Recovers lost tokens or ETH, only callable by Safe (admin)
     * @param token The token to recover (address(0) for ETH)
     * @param to The address to send the tokens to
     * @param amount The amount to recover
     */
    function recoverLost(address token, address to, uint256 amount) external onlyRole(DEFAULT_ADMIN_ROLE) {
        require(to != address(0), "Cannot send to zero address");
        if (token == address(0)) {
            // Recover ETH
            (bool sent, ) = to.call{value: amount}("");
            require(sent, "ETH transfer failed");
        } else {
            bool success = IERC20(token).transfer(to, amount);
            require(success, "Token transfer failed");
        }
    }

    /**
     * @dev Recovers all tokens of a specific type
     * @param token The token to recover
     * @param to The address to send the tokens to
     */
    function recover(
        IERC20 token,
        address to
    ) external onlyRole(DEFAULT_ADMIN_ROLE) {
        require(to != address(0), "Invalid recipient");
        uint256 balance = token.balanceOf(address(this));
        if (balance > 0) {
            token.safeTransfer(to, balance);
        }
    }
}
