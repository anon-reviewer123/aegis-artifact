import "@openzeppelin/contracts/utils/math/Math.sol";

/**
 * @title Flash Loan Validation Library
 * @notice Common validation functions for flash loan callbacks
 * @dev This library provides validation functions for flash loan operations
 * 
 * Security Considerations:
 * - Uses block numbers instead of timestamps to avoid miner manipulation
 * - Implements slippage protection to prevent sandwich attacks
 * - Validates profit to ensure operations are economically viable
 */
library FlashLoanValidation {
    using Math for uint256;

    // Errors
    error InsufficientProfit();
    error HighSlippageError(uint256 expected, uint256 actual, uint256 slippageBps);
    error InvalidDeadline();

    // Constants
    uint256 internal constant BPS = 10000;
    uint256 internal constant MIN_BLOCKS_BUFFER = 2; // Minimum blocks to wait before deadline
    uint256 internal constant BLOCKS_PER_MINUTE = 4; // Average blocks per minute on Ethereum

    /**
     * @dev Validates that the operation was profitable
     * @param startBalance Starting balance before operation
     * @param endBalance Ending balance after operation
     */
    function validateProfit(uint256 startBalance, uint256 endBalance) internal pure {
        if (endBalance <= startBalance) {
            revert InsufficientProfit();
        }
    }

    /**
     * @dev Validates slippage for an operation
     * @param expected Expected amount
     * @param actual Actual amount received
     * @param slippageBps Maximum allowed slippage in basis points
     */
    function validateSlippage(
        uint256 expected,
        uint256 actual,
        uint256 slippageBps
    ) internal pure {
        if (actual < expected) {
            uint256 slippage = ((expected - actual) * BPS) / expected;
            if (slippage > slippageBps) {
                revert HighSlippageError(expected, actual, slippageBps);
            }
        }
    }

    /**
     * @dev Validates deadline for an operation using block numbers
     * @param deadlineBlock The deadline block number
     * @notice This function uses block numbers instead of timestamps to avoid miner manipulation
     * @notice The minimum buffer is 2 blocks to account for network congestion
     * @notice On Ethereum mainnet, this provides approximately 30 seconds of buffer
     */
    function validateDeadline(uint256 deadlineBlock) internal view {
        if (deadlineBlock <= block.number + MIN_BLOCKS_BUFFER) {
            revert InvalidDeadline();
        }
    }

    /**
     * @dev Converts a timestamp deadline to block number
     * @param timestamp The deadline timestamp
     * @return The equivalent block number
     * @notice This is a rough estimation and should be used with caution
     * @notice The actual block number may vary due to network conditions
     */
    function timestampToBlockNumber(uint256 timestamp) internal view returns (uint256) {
        uint256 blocksFromNow = ((timestamp - block.timestamp) * BLOCKS_PER_MINUTE) / 60;
        return block.number + blocksFromNow;
    }
} 
