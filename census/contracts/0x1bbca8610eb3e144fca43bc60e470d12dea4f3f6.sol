pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/utils/Address.sol";
import "./interfaces/MarketParams.sol";
import "./libraries/MarketParamsLib.sol";
import "./interfaces/IMorpho.sol";
import "./interfaces/IMorphoCallbacks.sol";
import {Id} from "./interfaces/IMorpho.sol";

/**
 * @title Safe Flash Loan Module
 * @notice A module for executing flash loans through Morpho Protocol
 * @dev Implements core security features and flash loan functionality
 * 
 * Role Structure:
 * - DEFAULT_ADMIN_ROLE: Can manage whitelist, pause/unpause, and initiate flash loans
 */
contract SafeFlashLoanModule is AccessControl, Pausable, ReentrancyGuard {
    using SafeERC20 for IERC20;
    using Address for address;
    using MarketParamsLib for MarketParams;

    // Events
    event FlashLoanInitiated(
        address indexed token, 
        uint256 amount, 
        address indexed callback, 
        bytes32 indexed marketId,
        bool isUnwind
    );
    event FlashLoanCallbackExecuted(address indexed callback, bool success);
    event CallbackWhitelistUpdated(address indexed callback, bool whitelisted);
    event MarketWhitelistUpdated(bytes32 indexed marketId, bool whitelisted);
    event DebugLog(string message);

    // Errors
    error InvalidToken();
    error InvalidAmount();
    error InvalidCallback();
    error CallbackNotWhitelisted();
    error MarketNotWhitelisted();
    error HighSlippageError(uint256 expected, uint256 actual, uint256 slippageBps);
    error MarketAlreadyAdded();
    error MarketNotAdded();
    error FlashLoanFailed();
    error InvalidMarketIndex();

    // State variables
    address public immutable morpho;
    address public immutable safe;
    mapping(address => bool) public whitelistedCallbacks;
    mapping(Id => bool) public whitelistedMarkets;
    MarketParams[] public marketParamsList;
    mapping(Id => uint256) public marketIdToIndex; // 1-based index, 0 means not present

    /**
     * @dev Constructor initializes the flash loan module
     * @param _morpho Address of the Morpho Protocol
     * @param _safe Address of the Gnosis Safe
     */
    constructor(address _morpho, address _safe) {
        if (_morpho == address(0)) revert InvalidCallback();
        if (_safe == address(0)) revert InvalidCallback();

        morpho = _morpho;
        safe = _safe;

        // Grant DEFAULT_ADMIN_ROLE to the safe
        _grantRole(DEFAULT_ADMIN_ROLE, _safe);
    }

    /**
     * @dev Validates that a market is whitelisted and has a valid index
     * @param marketId The market ID to validate
     */
    function _validateMarket(Id marketId) internal view {
        if (!whitelistedMarkets[marketId]) revert MarketNotWhitelisted();
        if (marketIdToIndex[marketId] == 0) revert InvalidMarketIndex();
        if (marketIdToIndex[marketId] > marketParamsList.length) revert InvalidMarketIndex();
    }

    /**
     * @dev Adds a market to the whitelist using MarketParams
     * @param params The MarketParams struct
     */
    function addMarket(MarketParams calldata params) external onlyRole(DEFAULT_ADMIN_ROLE) {
        Id marketId = params.id();
        if (whitelistedMarkets[marketId]) revert MarketAlreadyAdded();
        // Ensure market ID computation matches the parameters
        bytes32 computedId = keccak256(abi.encode(
            params.loanToken,
            params.collateralToken,
            params.oracle,
            params.irm,
            params.lltv
        ));
        if (Id.unwrap(marketId) != computedId) revert InvalidToken();
        marketParamsList.push(params);
        marketIdToIndex[marketId] = marketParamsList.length; // 1-based
        whitelistedMarkets[marketId] = true;
        emit MarketWhitelistUpdated(Id.unwrap(marketId), true);
    }

    /**
     * @dev Removes a market from the whitelist
     * @param marketId The Morpho market ID to remove
     */
    function removeMarket(Id marketId) external onlyRole(DEFAULT_ADMIN_ROLE) {
        if (!whitelistedMarkets[marketId]) revert MarketNotAdded();
        uint256 idx = marketIdToIndex[marketId];
        if (idx == 0 || idx > marketParamsList.length) revert MarketNotAdded();
        uint256 lastIdx = marketParamsList.length;
        if (idx != lastIdx) {
            // Validate the last market before using it
            MarketParams memory lastMarket = marketParamsList[lastIdx - 1];
            Id lastMarketId = lastMarket.id();
            // Verify the last market's ID matches its parameters
            bytes32 computedLastId = keccak256(abi.encode(
                lastMarket.loanToken,
                lastMarket.collateralToken,
                lastMarket.oracle,
                lastMarket.irm,
                lastMarket.lltv
            ));
            if (Id.unwrap(lastMarketId) != computedLastId) revert InvalidToken();
            marketParamsList[idx - 1] = lastMarket;
            marketIdToIndex[lastMarketId] = idx;
        }
        marketParamsList.pop();
        delete marketIdToIndex[marketId];
        delete whitelistedMarkets[marketId];
        emit MarketWhitelistUpdated(Id.unwrap(marketId), false);
    }

    /**
     * @dev Returns all whitelisted markets and their params
     */
    function getMarkets() external view returns (MarketParams[] memory, bytes32[] memory) {
        uint256 len = marketParamsList.length;
        bytes32[] memory ids = new bytes32[](len);
        for (uint256 i = 0; i < len; i++) {
            ids[i] = Id.unwrap(marketParamsList[i].id());
        }
        return (marketParamsList, ids);
    }

    /**
     * @dev Initiates a flash loan through Morpho Protocol
     * @param marketId The Morpho market ID to use
     * @param amount The amount to borrow
     * @param callback The callback contract to execute
     * @param strategyData The encoded strategy data
     * @param isUnwind Whether this is an unwind operation
     */
    function initiateFlashLoan(
        Id marketId,
        uint256 amount,
        address callback,
        bytes calldata strategyData,
        bool isUnwind
    ) external onlyRole(DEFAULT_ADMIN_ROLE) whenNotPaused nonReentrant {
        _validateMarket(marketId);
        MarketParams memory params = marketParamsList[marketIdToIndex[marketId] - 1];
        if (params.loanToken == address(0)) revert InvalidToken();
        if (amount == 0) revert InvalidAmount();
        if (callback == address(0)) revert InvalidCallback();
        if (callback.code.length == 0) revert InvalidCallback();
        if (!whitelistedCallbacks[callback]) revert CallbackNotWhitelisted();
        // Encode callback data with all relevant info
        bytes memory data = abi.encode(
            marketId,
            safe,
            strategyData,
            isUnwind
        );
        // Execute flash loan
        emit FlashLoanInitiated(params.loanToken, amount, callback, Id.unwrap(marketId), isUnwind);
        try IMorpho(morpho).flashLoan(params.loanToken, amount, data) {
        } catch Error(string memory reason) {
            revert(reason);
        } catch (bytes memory lowLevelData) {
            revert("Module: flashLoan call failed");
        }
    }

    /**
     * @dev Updates the whitelist status of a callback contract
     * @param callback The callback contract address
     * @param whitelisted Whether to whitelist the callback
     */
    function updateCallbackWhitelist(
        address callback,
        bool whitelisted
    ) external onlyRole(DEFAULT_ADMIN_ROLE) {
        if (callback == address(0)) revert InvalidCallback();
        whitelistedCallbacks[callback] = whitelisted;
        emit CallbackWhitelistUpdated(callback, whitelisted);
    }

    /**
     * @dev Pauses the contract
     */
    function pause() external onlyRole(DEFAULT_ADMIN_ROLE) {
        _pause();
    }

    /**
     * @dev Unpauses the contract
     */
    function unpause() external onlyRole(DEFAULT_ADMIN_ROLE) {
        _unpause();
    }

    // Minimal recovery function: only Safe (admin) can recover any ERC20 or ETH
    function recoverLost(address token, address to, uint256 amount) external onlyRole(DEFAULT_ADMIN_ROLE) {
        require(to != address(0), "Cannot send to zero address");
        if (token == address(0)) {
            // Recover ETH
            (bool sent, ) = to.call{value: amount}("");
            require(sent, "ETH transfer failed");
        } else {
            bool success = IERC20(token).transfer(to, amount);
            require(success, "Token transfer failed");
        }
    }
}