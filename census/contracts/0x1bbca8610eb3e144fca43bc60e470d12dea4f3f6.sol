pragma solidity ^0.8.20;

import "../interfaces/IMorpho.sol";
import "../interfaces/IMorphoCallbacks.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

contract MockMorpho {
    using SafeERC20 for IERC20;

    event FlashLoanInitiated(address indexed token, uint256 amount, bytes data);
    event FlashLoanCompleted(address indexed token, uint256 amount);
    event DebugLog(string message);
    event DebugBytes32(string message, bytes32 value);
    event DebugAddress(string message, address value);
    event DebugUint(string message, uint256 value);

    function flashLoan(
        address token,
        uint256 amount,
        bytes calldata data
    ) external {
        emit DebugLog("MockMorpho.flashLoan called");
        
        // Decode the data as the real system expects
        (bytes32 marketId, address safeAddr, bytes memory strategyData, bool isUnwind) = abi.decode(data, (bytes32, address, bytes, bool));
        emit DebugBytes32("marketId", marketId);
        emit DebugAddress("safeAddr", safeAddr);
        emit DebugAddress("token", token);
        emit DebugUint("amount", amount);
        
        emit DebugLog("Checking balance");
        uint256 bal = IERC20(token).balanceOf(address(this));
        emit DebugUint("Current balance", bal);
        require(bal >= amount, "Insufficient balance");
        emit DebugLog("Balance sufficient");

        // Transfer tokens to the callback contract
        bool success = IERC20(token).transfer(msg.sender, amount);
        require(success, "Token transfer failed");
        emit DebugLog("Transferred token to callback");

        // Call the callback contract directly
        emit DebugLog("About to call callback");
        try IMorphoFlashLoanCallback(msg.sender).onMorphoFlashLoan(amount, data) {
            emit DebugLog("Callback succeeded");
        } catch Error(string memory reason) {
            emit DebugLog("Callback reverted with reason");
            emit DebugLog(reason);
            revert(reason);
        } catch (bytes memory) {
            emit DebugLog("Callback reverted (low-level)");
            revert("Operation failed");
        }

        // Transfer tokens back
        emit DebugLog("About to pull tokens back");
        bool pullSuccess = IERC20(token).transferFrom(msg.sender, address(this), amount);
        require(pullSuccess, "Failed to pull tokens back");
        emit DebugLog("Pulled tokens back");

        emit FlashLoanCompleted(token, amount);
    }

    // This function is used for test setup
    function approve(address token, address spender, uint256 amount) external {
        emit DebugLog("Morpho: approve called");
        emit DebugAddress("Morpho: approve token", token);
        emit DebugAddress("Morpho: approve spender", spender);
        emit DebugUint("Morpho: approve amount", amount);
        IERC20(token).approve(spender, amount);
    }

    // This function is used for test setup
    function setMarket(
        address token,
        bool isActive,
        uint256 maxSupply,
        uint256 maxBorrow,
        uint256 fee
    ) external {
        emit DebugLog("Morpho: setMarket called");
        emit DebugAddress("Morpho: setMarket token", token);
        emit DebugUint("Morpho: setMarket isActive", isActive ? 1 : 0);
        emit DebugUint("Morpho: setMarket maxSupply", maxSupply);
        emit DebugUint("Morpho: setMarket maxBorrow", maxBorrow);
        emit DebugUint("Morpho: setMarket fee", fee);
    }
} 
