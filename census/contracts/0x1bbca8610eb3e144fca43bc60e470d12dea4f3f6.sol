import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";

/// @title FlashLoanMath
/// @notice Library for flash loan calculations
/// @dev This library provides essential math functions for flash loan operations
library FlashLoanMath {
    using Math for uint256;

    /// @notice Calculates the minimum amount to receive after slippage
    /// @param amount The original amount
    /// @param slippageBps The maximum allowed slippage in basis points
    /// @return The minimum amount after slippage
    function minAmountAfterSlippage(uint256 amount, uint256 slippageBps) internal pure returns (uint256) {
        return amount.mulDiv(10000 - slippageBps, 10000);
    }

    /// @notice Calculates the profit from a flash loan operation
    /// @param startBalance The balance before the operation
    /// @param endBalance The balance after the operation
    /// @return The profit amount
    function calculateProfit(uint256 startBalance, uint256 endBalance) internal pure returns (uint256) {
        return endBalance > startBalance ? endBalance - startBalance : 0;
    }

    /// @notice Calculates the slippage percentage
    /// @param expected The expected amount
    /// @param actual The actual amount received
    /// @return The slippage in basis points
    function calculateSlippage(uint256 expected, uint256 actual) internal pure returns (uint256) {
        if (actual >= expected) return 0;
        return ((expected - actual) * 10000) / expected;
    }

    /// @notice Validates if slippage is within acceptable range
    /// @param expected The expected amount
    /// @param actual The actual amount received
    /// @param maxSlippageBps The maximum allowed slippage in basis points
    /// @return True if slippage is acceptable
    function isSlippageAcceptable(uint256 expected, uint256 actual, uint256 maxSlippageBps) internal pure returns (bool) {
        return calculateSlippage(expected, actual) <= maxSlippageBps;
    }
} 
