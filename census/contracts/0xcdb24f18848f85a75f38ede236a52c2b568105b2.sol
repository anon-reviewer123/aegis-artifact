pragma solidity 0.8.27;

// OpenZeppelin
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {IERC721Receiver} from "@openzeppelin/contracts/token/ERC721/IERC721Receiver.sol";
import {IERC721} from "@openzeppelin/contracts/token/ERC721/IERC721.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

// MoonThat
import {Decommissionable} from "../lib/Decommissionable.sol";
import {AuthorityModel} from "../lib/AuthorityModel.sol";
import {IMoonThatUniswapV3Vault} from "./IMoonThatUniswapV3Vault.sol";

// Uniswap v3
import {IPeripheryImmutableState} from "@uniswap/v3-periphery/contracts/interfaces/IPeripheryImmutableState.sol";
import {INonfungiblePositionManager} from "../vendor/uniswap/v3-periphery/INonfungiblePositionManager.sol";

contract MoonThatUniswapV3Vault is
  IMoonThatUniswapV3Vault,
  IERC721Receiver,
  Decommissionable,
  AuthorityModel,
  Pausable,
  ReentrancyGuard
{
  using SafeERC20 for IERC20;

  ///////////////
  // Constants //
  ///////////////

  uint256 private constant _BP_DENOM = 10_000;
  address private constant _DEAD_ADDRESS =
    0x000000000000000000000000000000000000dEaD;

  /////////////
  // Storage //
  /////////////

  // An always increasing counter for vaults.
  uint256 internal _vaultCounter;

  // Address for all platform fee payments.
  address internal _platformTreasury;

  // The mapping of existing vaults.
  mapping(uint256 => Vault) public vaults;

  // The current default fee structure that is taken on Uniswap fee collection per token.
  // This is used when creating a vault without specifying a custom pricing structure.
  // Existing vaults are not affected by changes to this value, only new vaults.
  PricingStructure internal _defaultPricingStructure;

  // The mapping of nonfungible position managers that are allowed to be used for new vaults.
  mapping(address => bool) internal _isNonfungiblePositionManager;

  // Whether rescue ERC-721 functionality is enabled. This is enabled by default, but able to be permanently disabled by platform admins.
  bool private _rescueERC721Enabled;

  constructor(
    address defaultAdmin_,
    address[] memory platformAdmins_,
    address[] memory collectAdmins_,
    address platformTreasury_,
    address[] memory nonfungiblePositionManagers_,
    PricingStructure memory defaultPricingStructure_
  ) AuthorityModel(1 days, defaultAdmin_, platformAdmins_) {
    if (platformTreasury_ == address(0)) {
      revert CannotBeZeroAddress();
    }

    _platformTreasury = platformTreasury_;

    _rescueERC721Enabled = true;

    _validatePricingStructure(defaultPricingStructure_);

    _defaultPricingStructure = defaultPricingStructure_;

    for (uint256 i = 0; i < collectAdmins_.length; ) {
      _grantRole(COLLECT_ADMIN_ROLE, collectAdmins_[i]);

      unchecked {
        ++i;
      }
    }

    for (uint256 i = 0; i < nonfungiblePositionManagers_.length; ) {
      // Make the change in state.
      _isNonfungiblePositionManager[nonfungiblePositionManagers_[i]] = true;

      // Emit an event for the change in state.
      emit IsNonfungiblePositionManagerUpdated(
        nonfungiblePositionManagers_[i],
        true
      );

      unchecked {
        ++i;
      }
    }
  }

  // Allows anyone to create a vault with the default pricing structure.
  function createVault(
    CreateVaultParams memory createVaultParams_
  )
    external
    whenNotDecommissioned
    whenNotPaused
    nonReentrant
    returns (uint256 vaultId)
  {
    // Special pricing structure for MoonThat community launches. This is open to the world because it's likely only going to be used by community launches.
    if (createVaultParams_.isMoonThatCommunityLaunch) {
      // We have to determine which token is WETH and which is the MoonThat token to set the correct fee structure.
      // MoonThat tokens are always paired with WETH. If WETH is not found, we revert.
      // Find the address of the token0 and token1 for the position.
      (
        ,
        ,
        address token0Address,
        address token1Address,
        ,
        ,
        ,
        ,
        ,
        ,
        ,

      ) = INonfungiblePositionManager(
          createVaultParams_.nonfungiblePositionManager
        ).positions(createVaultParams_.tokenId);

      bool tokenIsToken0;

      address weth = IPeripheryImmutableState(
        createVaultParams_.nonfungiblePositionManager
      ).WETH9();

      if (token0Address == weth) {
        tokenIsToken0 = false;
      } else if (token1Address == weth) {
        tokenIsToken0 = true;
      } else {
        revert NeitherTokenIsWETH();
      }

      // The pricing structure for MoonThat community launches works like this:
      // - The creator of the token is entitled to 100% of the token side fees.
      // - The platform is entitled to 100% of the WETH side fees.
      // - No tokens are burned.
      PricingStructure memory pricingStructure;

      // Platform claims 100% of the WETH-side fees generated, and 0% of the token-side fees generated.
      pricingStructure.token0PlatformCollectFeeBasisPoints = tokenIsToken0
        ? 0
        : _BP_DENOM;
      pricingStructure.token1PlatformCollectFeeBasisPoints = tokenIsToken0
        ? _BP_DENOM
        : 0;

      // No tokens are burned.
      pricingStructure.token0BurnBasisPoints = 0;
      pricingStructure.token1BurnBasisPoints = 0;

      vaultId = _createVault(createVaultParams_, pricingStructure);
    } else {
      vaultId = _createVault(createVaultParams_, _defaultPricingStructure);
    }
  }

  // Basic collect function that allows the owner or collectors to collect fees to the default recipient on the vault.
  function collect(
    uint256 vaultId_,
    uint128 maxAmountOutToken0_,
    uint128 maxAmountOutToken1_
  ) external nonReentrant {
    Vault storage vault = vaults[vaultId_];

    _restrictedCollect(
      vaultId_,
      maxAmountOutToken0_,
      maxAmountOutToken1_,
      vault.defaultFeeRecipient
    );
  }

  // Overloaded collect that allows for a fee recipient override.
  function collect(
    uint256 vaultId_,
    uint128 maxAmountOutToken0_,
    uint128 maxAmountOutToken1_,
    address feeRecipientOverride_
  ) external nonReentrant {
    _restrictedCollect(
      vaultId_,
      maxAmountOutToken0_,
      maxAmountOutToken1_,
      feeRecipientOverride_
    );
  }

  function multiCollect(
    uint256[] calldata vaultIds_,
    uint128[] calldata maxAmountOutToken0_,
    uint128[] calldata maxAmountOutToken1_
  ) external nonReentrant {
    if (
      vaultIds_.length != maxAmountOutToken0_.length ||
      vaultIds_.length != maxAmountOutToken1_.length
    ) {
      revert InvalidInputLengths();
    }

    for (uint256 i = 0; i < vaultIds_.length; ) {
      Vault storage vault = vaults[vaultIds_[i]];
      _restrictedCollect(
        vaultIds_[i],
        maxAmountOutToken0_[i],
        maxAmountOutToken1_[i],
        vault.defaultFeeRecipient
      );
      unchecked {
        ++i;
      }
    }
  }

  function multiCollect(
    uint256[] calldata vaultIds_,
    uint128[] calldata maxAmountOutToken0_,
    uint128[] calldata maxAmountOutToken1_,
    address[] calldata feeRecipientOverrides_
  ) external nonReentrant {
    if (
      vaultIds_.length != maxAmountOutToken0_.length ||
      vaultIds_.length != maxAmountOutToken1_.length ||
      vaultIds_.length != feeRecipientOverrides_.length
    ) {
      revert InvalidInputLengths();
    }

    for (uint256 i = 0; i < vaultIds_.length; ) {
      _restrictedCollect(
        vaultIds_[i],
        maxAmountOutToken0_[i],
        maxAmountOutToken1_[i],
        feeRecipientOverrides_[i]
      );
      unchecked {
        ++i;
      }
    }
  }

  // Allows the owner to withdraw the position from the vault using the default fee recipient for any remaining fees.
  function withdraw(
    uint256 vaultId_,
    address positionRecipient_
  ) external nonReentrant {
    Vault storage vault = vaults[vaultId_];
    _withdraw(vaultId_, positionRecipient_, vault.defaultFeeRecipient);
  }

  // Overloaded withdraw that allows for a fee recipient override.
  function withdraw(
    uint256 vaultId_,
    address positionRecipient_,
    address feeRecipientOverride_
  ) external nonReentrant {
    _withdraw(vaultId_, positionRecipient_, feeRecipientOverride_);
  }

  // Allows the owner to extend the lock period of the vault. This can be done at any time, even after the previous unlock date. So you can extend the lock period multiple times, even on a vault that has already unlocked.
  function extendLockPeriod(uint256 vaultId_, uint256 newUnlocksAt_) external {
    Vault storage vault = vaults[vaultId_];

    _requireVaultExists(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);

    // Check that the new unlock date is greater than the current unlock date.
    if (newUnlocksAt_ <= vault.unlocksAt) {
      revert NewUnlockDateLTECurrent();
    }

    // Check that the unlock date is in the future.
    if (newUnlocksAt_ <= block.timestamp) {
      revert UnlockDateInPast();
    }

    uint256 previousUnlocksAt = vault.unlocksAt;

    vault.unlocksAt = newUnlocksAt_;

    emit VaultLockPeriodExtended(vaultId_, previousUnlocksAt, newUnlocksAt_);
  }

  function transferVaultOwnership(
    uint256 vaultId_,
    address newOwner_
  ) external {
    Vault storage vault = vaults[vaultId_];

    _requireVaultExists(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);
    _requireVaultToBeTransferable(vaultId_);

    // Ownership cannot be transferred to the zero address. To renounce ownership of a vault, use renounceVaultOwnership.
    if (newOwner_ == address(0)) {
      revert CannotBeZeroAddress();
    }

    vault.owner = newOwner_;

    emit VaultOwnershipTransferred(vaultId_, msg.sender, newOwner_);
  }

  // Only the vault owner can update the collectors.
  function setIsCollector(
    uint256 vaultId_,
    address address_,
    bool isCollector_
  ) external {
    Vault storage vault = vaults[vaultId_];

    _requireVaultExists(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);

    // Sanity check so we revert if the address is already in the state the user is trying to set it to.
    if (vault.isCollector[address_] == isCollector_) {
      revert NoChange();
    }

    // Make the change in state.
    vault.isCollector[address_] = isCollector_;

    // Emit an event for the change in state.
    emit IsCollectorUpdated(vaultId_, address_, isCollector_);
  }

  function setDefaultFeeRecipient(
    uint256 vaultId_,
    address defaultFeeRecipient_
  ) external {
    Vault storage vault = vaults[vaultId_];

    _requireVaultExists(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);

    address previousDefaultFeeRecipient = vault.defaultFeeRecipient;

    if (defaultFeeRecipient_ == address(0)) {
      revert CannotBeZeroAddress();
    }

    if (vault.defaultFeeRecipient == defaultFeeRecipient_) {
      revert NoChange();
    }

    vault.defaultFeeRecipient = defaultFeeRecipient_;

    emit DefaultFeeRecipientUpdated(
      vaultId_,
      previousDefaultFeeRecipient,
      defaultFeeRecipient_
    );
  }

  // This function is used to renounce ownership of the vault. It is a separate function from transferVaultOwnership to prevent accidental transfers to the zero address.
  // Vaults do not need to be transferrable to renounce them.
  // This will freeze all configurations in place, including the collectors and the default fee recipient. If there are existing collectors on the vault, they will still be able to continue collecting fees. To prevent this, the owner should remove all collectors before renouncing ownership.
  // Also, the owner will not be in the collectors list unless they explicitly add themselves as a collector prior to renouncing.
  // The position can never be withdrawn from the vault after renouncing ownership.
  function renounceVaultOwnership(uint256 vaultId_) external {
    Vault storage vault = vaults[vaultId_];

    _requireVaultExists(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);

    // By renouncing vault ownership, the vault is effectively locked forever. Therefore, the lock period is extended to the maximum possible value for consistency if it's not already.
    if (vault.unlocksAt != type(uint256).max) {
      vault.unlocksAt = type(uint256).max;
    }

    // The owner is set to the zero address to indicate that the vault is ownerless.
    vault.owner = address(0);

    emit VaultOwnershipRenounced(vaultId_, msg.sender);
  }

  // This function is used to disable transfers of a vault. Once transfers are disabled, they cannot be re-enabled.
  function disableVaultTransferability(uint256 vaultId_) external {
    Vault storage vault = vaults[vaultId_];

    _requireVaultExists(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);
    // The vault must be transferable in order to disable transferability.
    _requireVaultToBeTransferable(vaultId_);

    vault.isTransferable = false;

    emit VaultTransfersDisabled(vaultId_);
  }

  function onERC721Received(
    address,
    address,
    uint256,
    bytes calldata
  ) external pure override returns (bytes4) {
    return this.onERC721Received.selector;
  }

  function isCollector(
    uint256 vaultId_,
    address address_
  ) external view returns (bool) {
    return vaults[vaultId_].isCollector[address_];
  }

  function isVaultLocked(uint256 vaultId_) external view returns (bool) {
    return _isVaultLocked(vaultId_);
  }

  function defaultPricingStructure()
    external
    view
    returns (PricingStructure memory)
  {
    return _defaultPricingStructure;
  }

  function isNonfungiblePositionManager(
    address nonfungiblePositionManager_
  ) external view returns (bool) {
    return _isNonfungiblePositionManager[nonfungiblePositionManager_];
  }

  function vaultCounter() external view returns (uint256) {
    return _vaultCounter;
  }

  function platformTreasury() external view returns (address) {
    return _platformTreasury;
  }

  function rescueERC721Enabled() external view returns (bool) {
    return _rescueERC721Enabled;
  }

  ////////////////////
  // Administrative //
  ////////////////////

  function pause() external onlyPlatformAdmin {
    _pause();
  }

  function unpause() external onlyPlatformAdmin {
    _unpause();
  }

  function adminCollect(
    uint256 vaultId_,
    uint128 maxAmountOutToken0_,
    uint128 maxAmountOutToken1_
  ) external onlyCollectAdmin nonReentrant {
    Vault storage vault = vaults[vaultId_];

    // adminCollect can only collect fees to the vault's default fee recipient, overriding the fee recipient is not allowed here.
    // Use unrestrictedCollect to bypass the check for the caller being the owner or a collector, since this is to be called by collect admins.
    _unrestrictedCollect(
      vaultId_,
      maxAmountOutToken0_,
      maxAmountOutToken1_,
      vault.defaultFeeRecipient
    );
  }

  function adminMultiCollect(
    uint256[] calldata vaultIds_,
    uint128[] calldata maxAmountOutToken0_,
    uint128[] calldata maxAmountOutToken1_
  ) external onlyCollectAdmin nonReentrant {
    if (
      vaultIds_.length != maxAmountOutToken0_.length ||
      vaultIds_.length != maxAmountOutToken1_.length
    ) {
      revert InvalidInputLengths();
    }

    for (uint256 i = 0; i < vaultIds_.length; ) {
      Vault storage vault = vaults[vaultIds_[i]];
      _unrestrictedCollect(
        vaultIds_[i],
        maxAmountOutToken0_[i],
        maxAmountOutToken1_[i],
        vault.defaultFeeRecipient
      );
      unchecked {
        ++i;
      }
    }
  }

  function setDefaultPricingStructure(
    PricingStructure calldata defaultPricingStructure_
  ) external onlyPlatformAdmin {
    // Validate the pricing structure.
    _validatePricingStructure(defaultPricingStructure_);

    // Store the previous default pricing structure.
    PricingStructure
      memory previousDefaultPricingStructure = _defaultPricingStructure;

    // Sanity check to ensure that the default pricing structure is not already set to the desired value.
    if (
      _defaultPricingStructure.token0PlatformCollectFeeBasisPoints ==
      defaultPricingStructure_.token0PlatformCollectFeeBasisPoints &&
      _defaultPricingStructure.token1PlatformCollectFeeBasisPoints ==
      defaultPricingStructure_.token1PlatformCollectFeeBasisPoints &&
      _defaultPricingStructure.token0BurnBasisPoints ==
      defaultPricingStructure_.token0BurnBasisPoints &&
      _defaultPricingStructure.token1BurnBasisPoints ==
      defaultPricingStructure_.token1BurnBasisPoints
    ) {
      revert NoChange();
    }

    // Make the change in state.
    _defaultPricingStructure = defaultPricingStructure_;

    // Emit an event for the change in state.
    emit DefaultPricingStructureUpdated(
      previousDefaultPricingStructure,
      _defaultPricingStructure
    );
  }

  function decommission() external onlyPlatformAdmin {
    _decommission();
  }

  function setPlatformTreasury(
    address platformTreasury_
  ) external onlyPlatformAdmin {
    // Platform treasury cannot be the zero address.
    if (platformTreasury_ == address(0)) {
      revert CannotBeZeroAddress();
    }

    // Sanity check to ensure that the platform treasury is not already set to the desired value.
    if (platformTreasury_ == _platformTreasury) {
      revert NoChange();
    }

    address previousPlatformTreasury = _platformTreasury;

    // Make the change in state.
    _platformTreasury = platformTreasury_;

    // Emit an event for the change in state.
    emit PlatformTreasuryUpdated(previousPlatformTreasury, platformTreasury_);
  }

  function setIsNonfungiblePositionManager(
    address nonfungiblePositionManager_,
    bool isNonfungiblePositionManager_
  ) external onlyPlatformAdmin {
    // Sanity check to ensure that the nonfungiblePositionManager is not already in the state the user is trying to set it to.
    if (
      _isNonfungiblePositionManager[nonfungiblePositionManager_] ==
      isNonfungiblePositionManager_
    ) {
      revert NoChange();
    }

    // Make the change in state.
    _isNonfungiblePositionManager[
      nonfungiblePositionManager_
    ] = isNonfungiblePositionManager_;

    // Emit an event for the change in state.
    emit IsNonfungiblePositionManagerUpdated(
      nonfungiblePositionManager_,
      isNonfungiblePositionManager_
    );
  }

  function calculateFeeBreakdown(
    uint256 vaultId_,
    uint256 token0TotalCollected_,
    uint256 token1TotalCollected_
  )
    external
    view
    returns (
      uint256 token0PlatformCollectFee,
      uint256 token0ToBurn,
      uint256 token0ToDistribute,
      uint256 token1PlatformCollectFee,
      uint256 token1ToBurn,
      uint256 token1ToDistribute
    )
  {
    Vault storage vault = vaults[vaultId_];

    (
      token0PlatformCollectFee,
      token0ToBurn,
      token0ToDistribute
    ) = _calculateFeeBreakdown(
      token0TotalCollected_,
      vault.pricingStructure.token0PlatformCollectFeeBasisPoints,
      vault.pricingStructure.token0BurnBasisPoints
    );

    (
      token1PlatformCollectFee,
      token1ToBurn,
      token1ToDistribute
    ) = _calculateFeeBreakdown(
      token1TotalCollected_,
      vault.pricingStructure.token1PlatformCollectFeeBasisPoints,
      vault.pricingStructure.token1BurnBasisPoints
    );
  }

  ////////////
  // Rescue //
  ////////////

  // Rogue ERC-20s should never be in the contract. Fees are distributed immediately uppon collection, and the vault only holds NFTs representing positions.
  function rescueERC20(
    address token_,
    address to_,
    uint256 amount_
  ) external onlyRescueAdmin {
    IERC20(token_).safeTransfer(to_, amount_);
  }

  // Rogue ETH should never be in the contract, but if it is, it should be rescuable.
  function rescueETH(address to_, uint256 amount_) external onlyRescueAdmin {
    (bool success, ) = to_.call{value: amount_}("");
    if (!success) {
      revert TransferFailed();
    }
  }

  // This function can rescue any ERC-721 held by the contract, including Uniswap V3 NFTs.
  // It is meant to be a failsafe in case of an emergency, and should not be used under normal circumstances.
  // It can be permanently disabled by a platform admin in the future.
  function rescueERC721(
    address token_,
    address to_,
    uint256 tokenId_
  ) external onlyRescueAdmin {
    if (!_rescueERC721Enabled) {
      revert RescueERC721NotAllowed();
    }

    IERC721(token_).safeTransferFrom(address(this), to_, tokenId_);
  }

  function permanentlyDisableRescueERC721() external onlyPlatformAdmin {
    if (!_rescueERC721Enabled) {
      revert NoChange();
    }

    _rescueERC721Enabled = false;
    emit RescueERC721PermanentlyDisabled();
  }

  //////////////////////////
  // Fallback and Receive //
  //////////////////////////

  /**
   * @dev Reverts any ETH sent to this contract.
   *
   * This function is called when ETH is sent to the contract and no other
   * function matches the data payload, and there is no data in the transaction.
   */
  receive() external payable {
    revert ReceiveNotAllowed();
  }

  /**
   * @dev Reverts any call to the contract that does not match any function signature.
   *
   * This function is called when ETH is sent with data that doesn't match any function
   * signatures or when non-ETH data payloads are sent.
   */
  fallback() external payable {
    revert FallbackNotAllowed();
  }

  //////////////
  // Internal //
  //////////////

  function _validatePricingStructure(
    PricingStructure memory pricingStructure_
  ) internal pure {
    if (
      pricingStructure_.token0PlatformCollectFeeBasisPoints +
        pricingStructure_.token0BurnBasisPoints >
      _BP_DENOM
    ) {
      revert InvalidPricingStructure(true); // true == token0
    }

    if (
      pricingStructure_.token1PlatformCollectFeeBasisPoints +
        pricingStructure_.token1BurnBasisPoints >
      _BP_DENOM
    ) {
      revert InvalidPricingStructure(false); // false == token1
    }
  }

  function _createVault(
    CreateVaultParams memory createVaultParams_,
    PricingStructure memory pricingStructure_
  ) internal returns (uint256 vaultId) {
    // Check that the nonfungiblePositionManager is permitted.
    if (
      !_isNonfungiblePositionManager[
        createVaultParams_.nonfungiblePositionManager
      ]
    ) {
      revert NonfungiblePositionManagerNotPermitted(
        createVaultParams_.nonfungiblePositionManager
      );
    }

    // Check that the unlock date is in the future.
    if (createVaultParams_.unlocksAt <= block.timestamp) {
      revert UnlockDateInPast();
    }

    // Check that the default fee recipient is not zero.
    if (createVaultParams_.defaultFeeRecipient == address(0)) {
      revert CannotBeZeroAddress();
    }

    // Check that the owner is not zero.
    if (createVaultParams_.owner == address(0)) {
      revert CannotBeZeroAddress();
    }

    _validatePricingStructure(pricingStructure_);

    // Sufficient approval must have been already granted to this contract in order to transfer the token.
    IERC721(createVaultParams_.nonfungiblePositionManager).safeTransferFrom(
      msg.sender,
      address(this),
      createVaultParams_.tokenId
    );

    // Collect and disburse any fees already accrued up to this point. We are not entitled to these fees as they were accrued before the position was locked. Any fees collected are transferred directly to msg.sender.
    INonfungiblePositionManager(createVaultParams_.nonfungiblePositionManager)
      .collect(
        INonfungiblePositionManager.CollectParams({
          tokenId: createVaultParams_.tokenId,
          recipient: msg.sender,
          amount0Max: type(uint128).max,
          amount1Max: type(uint128).max
        })
      );

    // The first vault starts at 1.
    // This is done because a vault ID of 0 is used to indicate that a vault does not exist.
    unchecked {
      ++_vaultCounter;
    }

    vaultId = _vaultCounter;

    // Create the vault struct without trying to set the mapping directly
    Vault storage newVault = vaults[vaultId];
    newVault.id = vaultId;
    newVault.nonfungiblePositionManager = createVaultParams_
      .nonfungiblePositionManager;
    newVault.tokenId = createVaultParams_.tokenId;
    newVault.owner = createVaultParams_.owner;
    newVault.defaultFeeRecipient = createVaultParams_.defaultFeeRecipient;
    newVault.unlocksAt = createVaultParams_.unlocksAt;
    newVault.isTransferable = createVaultParams_.isTransferable;
    // Set the pricing structure. This is the key difference between this internal function and createVault.
    newVault.pricingStructure = pricingStructure_;

    // Add any additional collectors passed in.
    for (uint256 i = 0; i < createVaultParams_.collectors.length; ) {
      newVault.isCollector[createVaultParams_.collectors[i]] = true;
      emit IsCollectorUpdated(vaultId, createVaultParams_.collectors[i], true);
      unchecked {
        ++i;
      }
    }

    // Emit an event for the creation of the vault.
    emit VaultCreated(
      vaultId,
      createVaultParams_.owner,
      createVaultParams_.defaultFeeRecipient,
      createVaultParams_.nonfungiblePositionManager,
      createVaultParams_.tokenId,
      createVaultParams_.unlocksAt,
      createVaultParams_.isTransferable,
      pricingStructure_
    );

    return vaultId;
  }

  // This function is used to collect fees from the position.
  // It is restricted, meaning that it checks if the caller is the owner or a collector. This is intended to be used by the owner or collectors.
  function _restrictedCollect(
    uint256 vaultId_,
    uint128 maxAmountOutToken0_,
    uint128 maxAmountOutToken1_,
    address feeRecipient_
  ) internal {
    _requireCallerToBeOwnerOrCollector(vaultId_);

    _unrestrictedCollect(
      vaultId_,
      maxAmountOutToken0_,
      maxAmountOutToken1_,
      feeRecipient_
    );
  }

  // This function is used to collect fees from the position.
  // It is unrestricted, meaning that it does not check if the caller is the owner or a collector. This is intended to be used by collect admins. Be very careful when using this function directly. Generally you'll use _restrictedCollect instead.
  function _unrestrictedCollect(
    uint256 vaultId_,
    uint128 maxAmountOutToken0_,
    uint128 maxAmountOutToken1_,
    address feeRecipient_
  ) internal {
    _requireVaultExists(vaultId_);

    Vault storage vault = vaults[vaultId_];

    (
      ,
      ,
      address token0Address,
      address token1Address,
      ,
      ,
      ,
      ,
      ,
      ,
      ,

    ) = INonfungiblePositionManager(vault.nonfungiblePositionManager).positions(
        vault.tokenId
      );

    IERC20 token0 = IERC20(token0Address);
    IERC20 token1 = IERC20(token1Address);

    uint256 initialBalanceOfToken0 = token0.balanceOf(address(this));
    uint256 initialBalanceOfToken1 = token1.balanceOf(address(this));

    // Collect the fees from the position.
    INonfungiblePositionManager(vault.nonfungiblePositionManager).collect(
      INonfungiblePositionManager.CollectParams({
        tokenId: vault.tokenId,
        recipient: address(this),
        amount0Max: maxAmountOutToken0_,
        amount1Max: maxAmountOutToken1_
      })
    );

    uint256 collectedToken0 = token0.balanceOf(address(this)) -
      initialBalanceOfToken0;
    uint256 collectedToken1 = token1.balanceOf(address(this)) -
      initialBalanceOfToken1;

    if (collectedToken0 > 0) {
      _calculateAndDistributeFees(
        vaultId_,
        feeRecipient_,
        token0Address,
        collectedToken0,
        vault.pricingStructure.token0PlatformCollectFeeBasisPoints,
        vault.pricingStructure.token0BurnBasisPoints
      );
    }

    if (collectedToken1 > 0) {
      _calculateAndDistributeFees(
        vaultId_,
        feeRecipient_,
        token1Address,
        collectedToken1,
        vault.pricingStructure.token1PlatformCollectFeeBasisPoints,
        vault.pricingStructure.token1BurnBasisPoints
      );
    }
  }

  function _withdraw(
    uint256 vaultId_,
    address feeRecipient_,
    address positionRecipient_
  ) internal {
    _requireVaultExists(vaultId_);
    _requireVaultToBeUnlocked(vaultId_);
    _requireCallerToBeVaultOwner(vaultId_);

    Vault storage vault = vaults[vaultId_];

    // Collect and disburse any fees accrued up to this point.
    _restrictedCollect(
      vaultId_,
      type(uint128).max,
      type(uint128).max,
      feeRecipient_
    );

    // Transfer the position to the desired recipient.
    IERC721(vault.nonfungiblePositionManager).safeTransferFrom(
      address(this),
      positionRecipient_,
      vault.tokenId
    );

    // Delete the vault record to ensure that the vault can't be interacted with again.
    delete vaults[vaultId_];

    // Emit an event for the withdrawal.
    emit VaultWithdrawn(vaultId_, positionRecipient_);
  }

  function _calculateFeeBreakdown(
    uint256 amountCollected_,
    uint256 platformCollectFeeBasisPoints_,
    uint256 burnBasisPoints_
  )
    internal
    pure
    returns (
      uint256 platformCollectFee,
      uint256 amountToBurn,
      uint256 amountToDistribute
    )
  {
    // Calculate the platform's share of the fees.
    platformCollectFee =
      (amountCollected_ * platformCollectFeeBasisPoints_) /
      _BP_DENOM;
    // Calculate the amount to burn.
    amountToBurn = (amountCollected_ * burnBasisPoints_) / _BP_DENOM;
    // Any remaining amount is the recipient's share. The two integer divisions take the floor, so the result of the subtraction will always be >= 0.
    amountToDistribute = amountCollected_ - platformCollectFee - amountToBurn;
  }

  function _calculateAndDistributeFees(
    uint256 vaultId_,
    address recipient_,
    address tokenAddress_,
    uint256 amountCollected_,
    uint256 platformCollectFeeBasisPoints_,
    uint256 burnBasisPoints_
  ) internal {
    IERC20 token = IERC20(tokenAddress_);

    (
      uint256 platformCollectFee,
      uint256 amountToBurn,
      uint256 amountToDistribute
    ) = _calculateFeeBreakdown(
        amountCollected_,
        platformCollectFeeBasisPoints_,
        burnBasisPoints_
      );

    // If the platform has a share, transfer it.
    if (platformCollectFee > 0) {
      // Distribute the platform's share.
      token.safeTransfer(_platformTreasury, platformCollectFee);
      // Emit an event for the collected fees.
      emit PlatformFeeCollected(vaultId_, tokenAddress_, platformCollectFee);
    }

    // If there is an amount to burn, burn it.
    if (amountToBurn > 0) {
      // Burn the amount.
      token.safeTransfer(_DEAD_ADDRESS, amountToBurn);
      emit FeeTokensBurned(vaultId_, tokenAddress_, amountToBurn);
    }

    // If there's anything left, distribute it as the fee recipient's share.
    if (amountToDistribute > 0) {
      token.safeTransfer(recipient_, amountToDistribute);
      emit FeeTokensDistributed(vaultId_, tokenAddress_, amountToDistribute);
    }
  }

  function _requireVaultToBeUnlocked(uint256 vaultId_) internal view {
    if (_isVaultLocked(vaultId_)) {
      revert VaultNotUnlocked();
    }
  }

  function _requireCallerToBeVaultOwner(uint256 vaultId_) internal view {
    Vault storage vault = vaults[vaultId_];
    if (msg.sender != vault.owner) {
      revert CallerNotVaultOwner();
    }
  }

  function _requireVaultToBeTransferable(uint256 vaultId_) internal view {
    Vault storage vault = vaults[vaultId_];
    if (!vault.isTransferable) {
      revert VaultNotTransferable();
    }
  }

  // The first vault starts at 1. If a vault's ID is 0, it does not exist.
  function _requireVaultExists(uint256 vaultId_) internal view {
    if (vaults[vaultId_].id == 0) {
      revert VaultNotFound();
    }
  }

  function _requireCallerToBeOwnerOrCollector(uint256 vaultId_) internal view {
    Vault storage vault = vaults[vaultId_];

    if (msg.sender != vault.owner && !vault.isCollector[msg.sender]) {
      revert CallerNeitherVaultOwnerNorCollector();
    }
  }

  function _isVaultLocked(uint256 vaultId_) internal view returns (bool) {
    Vault storage vault = vaults[vaultId_];
    return vault.unlocksAt > block.timestamp;
  }
}

