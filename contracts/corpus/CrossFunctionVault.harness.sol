/// Auto-generated phase-split harness for CrossFunctionVault.
/// Generated by aegis.harness_synth from exposure site:
///   function withdraw -> .onAssetReceived  (ERC777-style asset hook can re-enter)
contract CrossFunctionVaultH {
    mapping(address => uint256) public shares;
    bool public exposed;
    uint256 public inFlight;
    uint256 public totalAssets;
    uint256 public totalShares;
    uint256 public _sum_shares; // [ghost] sum over shares
    uint256 public snapPre; // [ghost] entry snapshot for same-variable conservation


    /// Constructor takes an address for interface uniformity with the
    /// obligation compiler, which instantiates every harness as
    /// `new CrossFunctionVaultH(address(this))`. The address is ignored: this harness
    /// models the adversary through its callback wrappers, not through a
    /// stored receiver field.
    constructor(address /*receiver*/) {}

    function depositFor(address who, uint256 amount) public {
        shares[who]  += amount;
        _sum_shares  += amount;   // keep sum ghost consistent
        totalAssets  += amount;
        totalShares  += amount;
    }

    /// PRE phase of withdraw: establishes the exposure invariant.
    function beginExposed(uint256 amount) public {
        shares[msg.sender] -= amount;
        _sum_shares -= amount;
        totalShares -= amount;
        inFlight += amount;
        exposed = true;
    }

    /// POST phase of withdraw: restores the stable invariant.
    function endExposed(uint256 amount) public {
        require(exposed && inFlight == amount, "phase mismatch");
        totalAssets -= amount;
        inFlight -= amount;
        exposed = false;
    }

    /// Closure callback: wraps deposit so OBL_cb_deposit can drive it.
    function deposit(uint256 amount) public {
        uint256 a = amount;
        shares[msg.sender] += a;
        totalShares += a;
        totalAssets += a;
    }

    /// Closure callback: wraps transfer so OBL_cb_transfer can drive it.
    function transfer(uint256 amount) public {
        address to = address(this);
        uint256 a = amount;
        require(shares[msg.sender] >= a);
        shares[msg.sender] -= a;
        shares[to] += a;
    }

}
