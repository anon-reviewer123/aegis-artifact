    function depositFor(address who, uint256 amount) public {
        balance  += amount;
        owed[who]  += amount;
        totalOwed  += amount;
    }

    /// PRE phase of claim: establishes the exposure invariant.
    function beginExposed(uint256 amount) public {
        address hook = address(this);
        owed[msg.sender] -= amount;
        totalOwed -= amount;
        inFlight += amount;
        exposed   = true;
    }

    /// POST phase of claim: restores the stable invariant.
    function endExposed(uint256 amount) public {
        require(exposed && inFlight == amount, "phase mismatch");
        address hook = address(this);
        balance -= amount;
        inFlight -= amount;
        exposed   = false;
    }

    /// Closure callback: wraps fund so OBL_cb_fund can drive it.
