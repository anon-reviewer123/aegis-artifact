/// Auto-generated phase-split harness for EscrowSafe.
/// Generated by aegis.harness_synth from exposure site:
///   function claim -> .onWithdraw  (external interface callback may re-enter)
contract EscrowSafeH {
    mapping(address => uint256) public owed;
    uint256 public balance;
    uint256 public totalOwed;
    uint256 public inFlight;
    bool    public exposed;

    /// Constructor takes an address for interface uniformity with the
