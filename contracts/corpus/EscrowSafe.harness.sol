    function sweep(uint256 amount) public {
        require(!exposed, "exposed");
        require(balance > totalOwed, "no surplus");
        uint256 surplus = balance - totalOwed;
        owed[msg.sender] += surplus;
        totalOwed += surplus;
    }
}
