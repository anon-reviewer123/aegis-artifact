pragma solidity >=0.8.4;
/// Auto-generated phase-split harness for KatRoyalties.
/// Generated by aegis.harness_synth from exposure site:
///   function withdraw -> .call  (low-level value transfer can re-enter)
contract KatRoyaltiesH {
    mapping(address => uint256) public balances;
    mapping(address => uint256) public chances;
    address public KatMonstarz;
    address public KatWalkerz;
    uint256 public currentPrize;
    address[] public entries;
    uint256 public lastSpin;
    uint256 public maxWinners;
    uint256 public minEntries;
    uint256 public minSpin;
    uint256 public minVotes;
    address public owner;
    uint256[6] public proposal;
    uint256 public royaltiesSplit;
    uint256 public spinInterval;
    bool public spinning;
    address[] public votes;
    bool public voting;
    uint256 public winnerFunds;
    address[] public winners;
    bool public withdrawing;
    uint256 public km;   // symbolic (immutable/helper/constant)
    uint256 public kw;   // symbolic (immutable/helper/constant)
    uint256 public maxChances;   // symbolic (immutable/helper/constant)
    uint256 public inFlight;
    uint256 public _sum_balances; // [ghost] sum over balances
    uint256 public amount;   // [cross-phase] PRE local used in POST
    uint256 public snapPre; // [ghost] entry snapshot for same-variable conservation
    bool    public exposed;

    /// Constructor takes an address for interface uniformity with the
    /// obligation compiler, which instantiates every harness as
    /// `new KatRoyaltiesH(address(this))`. The address is ignored: this harness
    /// models the adversary through its callback wrappers, not through a
    /// stored receiver field.
    constructor(address /*receiver*/) {}

    function depositFor(address who, uint256 amount) public {
        balances[who]  += amount;
        _sum_balances  += amount;   // keep sum ghost consistent
        chances[who]  += amount;
        currentPrize  += amount;
        lastSpin  += amount;
        maxWinners  += amount;
        minEntries  += amount;
        minSpin  += amount;
        minVotes  += amount;
        royaltiesSplit  += amount;
        spinInterval  += amount;
        winnerFunds  += amount;
    }

    /// PRE phase of withdraw: establishes the exposure invariant.
    function beginExposed(uint256 amount) public {
        snapPre = winnerFunds;
        address addr = address(uint160(amount));
        amount = balances[msg.sender];
        withdrawing = true;
        inFlight += amount;
        exposed   = true;
    }

    /// POST phase of withdraw: restores the stable invariant.
    function endExposed(uint256 amount) public {
        require(exposed && inFlight == amount, "phase mismatch");
        address addr = address(uint160(amount));
        uint256 __prev0 = balances[msg.sender];
        balances[msg.sender] = 0;
        _sum_balances = _sum_balances + 0 - __prev0;
        winnerFunds -= amount;
        withdrawing = false;
        inFlight -= amount;
        exposed   = false;
    }

    /// Closure callback: wraps enter so OBL_cb_enter can drive it.
    function enter(uint256 amount) public {
        require(km > 0, "must hold katmonstarz");
        require(kw > 0, "must hold katwalkerz");
    }

    /// Closure callback: wraps settings so OBL_cb_settings can drive it.
    function settings(uint256 amount) public {
        uint256[] memory newRules = new uint256[](0);
        require(msg.sender == owner, "only owner");
        require(newRules.length == 6, "iykyk");
        for (uint256 i = 0; i < 6; i++) {
            proposal[i] = newRules[i];
        }
        votes = new address[](0);
        voting = true;
    }

    /// Closure callback: wraps spin so OBL_cb_spin can drive it.
    function spin(uint256 amount) public {
        require(!spinning, "spinning in process");
        require(block.timestamp - lastSpin > spinInterval, "not available");
        require(entries.length >= minEntries, "not enough entries");
        require(address(this).balance - winnerFunds > minSpin, "not enough balance");
        spinning = true;
        uint256 amount = address(this).balance - winnerFunds;
        uint256 split = amount / royaltiesSplit;
        uint256 share = split / maxWinners;
        address[] memory spinner = new address[](maxChances);
        uint256 luck = 0;
        uint256 karma = 0;
        while (karma < maxChances) {
            for (uint256 j = 0; j < chances[entries[luck]]; j++) {
                spinner[karma] = entries[luck];
                karma++;
            }
            luck++;
        }
        winners = new address[](0);
        winnerFunds += split;
        currentPrize = split;
        lastSpin = block.timestamp;
        spinning = false;
    }

    /// Closure callback: wraps vote so OBL_cb_vote can drive it.
    function vote(uint256 amount) public {
        require(voting, "no new proposal");
    }
    function checkBalance(address addr) public view returns (uint256) {
        return balances[addr];
    }
}
