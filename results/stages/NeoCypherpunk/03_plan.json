{
 "contract": "NeoCypherpunk",
 "closure": {
  "site_function": "feeClaim",
  "site_call": ".call",
  "functions": [
   "claimMarketingFees",
   "transfer",
   "transferFrom"
  ],
  "justification": "These functions interact with the pendingmarketingFees and can be called during reentrancy."
 },
 "protocol": {
  "during_phase": "exposed",
  "allowed_callbacks": [
   "claimMarketingFees",
   "transfer",
   "transferFrom"
  ],
  "nesting_bound": {
   "claimMarketingFees": 1,
   "transfer": 1,
   "transferFrom": 1
  }
 },
 "phases": {
  "function": "feeClaim",
  "pre": {
   "name": "pre",
   "from_marker": "entry",
   "to_marker": "before_call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "before_call",
   "to_marker": "after_call"
  },
  "post": {
   "name": "post",
   "from_marker": "after_call",
   "to_marker": "exit"
  },
  "linearization_point": "after_call"
 },
 "ghost_state": [
  {
   "name": "inFlight",
   "sol_type": "uint256",
   "meaning": "Amount of pendingmarketingFees in-flight during the callback window",
   "backed_by_storage": false
  }
 ],
 "exposure_invariant": {
  "formula": "pendingmarketingFees == snapPre + inFlight",
  "stable_formula": "pendingmarketingFees == snapPre",
  "kind": "conserve"
 },
 "composition": {
  "target_property": "pendingmarketingFees <= _balances[address(this)]",
  "rule": "The exposure invariant ensures that pendingmarketingFees is correctly accounted for during reentrancy, maintaining the target property."
 }
}