contract Obligation {
    ReservaXH v;
    constructor() { v = new ReservaXH(address(this)); }

        function check(uint256 amount) public {
            require(v.exposed());
            require(v.withdrawNine() + v.withdrawTen() == v._totalSupply(9) + v._totalSupply(10) + v.inFlight());                // assume I_exp at call return
            require(v.inFlight() == amount); // post settles the full in-flight amount
            v.endExposed(amount);                 // POST phase body
            assert(v.withdrawNine() + v.withdrawTen() == v._totalSupply(9) + v._totalSupply(10));             // I_stable restored
            assert(v.inFlight() == 0);     // in-flight ghost fully settled
            assert(!v.exposed());             // exposed phase exited
        }
