{
 "contract": "VulnerableContract",
 "closure": {
  "site_function": "withdraw",
  "site_call": ".call",
  "functions": [
   "deposit",
   "withdraw"
  ],
  "justification": "Both deposit and withdraw involve balances or ethBal, making them part of the conservative closure."
 },
 "protocol": {
  "during_phase": "exposed",
  "allowed_callbacks": [
   "deposit"
  ],
  "nesting_bound": {
   "withdraw": 0
  }
 },
 "phases": {
  "function": "withdraw",
  "pre": {
   "name": "pre",
   "from_marker": "start_withdraw",
   "to_marker": "before_call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "before_call",
   "to_marker": "after_call"
  },
  "post": {
   "name": "post",
   "from_marker": "after_call",
   "to_marker": "end_withdraw"
  },
  "linearization_point": "after_call"
 },
 "ghost_state": [
  {
   "name": "inFlight",
   "sol_type": "uint",
   "meaning": "The amount of ether being transferred during the callback window.",
   "backed_by_storage": false
  }
 ],
 "exposure_invariant": {
  "formula": "_sum_balances == _ethBal + inFlight",
  "stable_formula": "_sum_balances == _ethBal",
  "kind": "conserve",
  "derived_from_pre": false
 },
 "composition": {
  "target_property": "_sum_balances == _ethBal",
  "rule": "The exposure invariant ensures that the relationship between balances and ethBal is preserved despite re-entrancy."
 }
}