{
 "contract": "BULLRUNNERSCLUB",
 "closure": {
  "site_function": "withdraw",
  "site_call": ".call",
  "functions": [],
  "justification": "public functions sharing exposed accounting state"
 },
 "protocol": {
  "during_phase": "withdraw.exposed",
  "allowed_callbacks": [],
  "nesting_bound": {
   "withdraw": 1
  }
 },
 "phases": {
  "function": "withdraw",
  "pre": {
   "name": "pre",
   "from_marker": "function_entry",
   "to_marker": "before_external_call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "external_call",
   "to_marker": "call_return"
  },
  "post": {
   "name": "post",
   "from_marker": "after_external_call",
   "to_marker": "function_exit"
  },
  "linearization_point": "effect commit in pre-phase"
 },
 "ghost_state": [
  {
   "name": "inFlight",
   "sol_type": "uint256",
   "meaning": "quantity committed but not yet settled across the callback window",
   "backed_by_storage": false
  }
 ],
 "exposure_invariant": {
  "formula": "team_balance <= _ethBal + inFlight",
  "stable_formula": "team_balance <= _ethBal",
  "kind": "additive",
  "derived_from_pre": true
 },
 "composition": {
  "target_property": "team_balance <= _ethBal",
  "rule": "If pre establishes I_exp, every admissible callback preserves I_exp, the protocol over-approximates concrete callbacks, and post restores I_stable, then the target property holds under adversarial callbacks."
 }
}