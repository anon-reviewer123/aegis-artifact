{
 "contract": "AmenoToken",
 "closure": {
  "site_function": "swapAndSendMarketingFee",
  "site_call": ".call",
  "functions": [
   "transfer",
   "transferFrom"
  ],
  "justification": "These functions interact with pendingMarketingFee and pendingBurnFee, which are involved in the target property."
 },
 "protocol": {
  "during_phase": "exposed",
  "allowed_callbacks": [
   "transfer",
   "transferFrom"
  ],
  "nesting_bound": {
   "transfer": 1,
   "transferFrom": 1
  }
 },
 "phases": {
  "function": "swapAndSendMarketingFee",
  "pre": {
   "name": "pre",
   "from_marker": "entry",
   "to_marker": "before .call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "before .call",
   "to_marker": "after .call"
  },
  "post": {
   "name": "post",
   "from_marker": "after .call",
   "to_marker": "exit"
  },
  "linearization_point": "after .call"
 },
 "ghost_state": [
  {
   "name": "inFlight",
   "sol_type": "uint256",
   "meaning": "Amount of pendingMarketingFee in-flight during callback",
   "backed_by_storage": false
  }
 ],
 "exposure_invariant": {
  "formula": "pendingMarketingFee + pendingBurnFee <= _balances[address(this)] + inFlight",
  "stable_formula": "pendingMarketingFee + pendingBurnFee <= _balances[address(this)]",
  "kind": "bounded",
  "derived_from_pre": false
 },
 "composition": {
  "target_property": "pendingMarketingFee + pendingBurnFee <= _balances[address(this)]",
  "rule": "The exposure invariant ensures that the sum of pending fees does not exceed the contract's balance, even during reentrant calls."
 }
}