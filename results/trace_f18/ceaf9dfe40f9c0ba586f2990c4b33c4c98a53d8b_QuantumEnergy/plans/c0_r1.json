{
 "contract": "QuantumEnergy",
 "closure": {
  "site_function": "sendFee",
  "site_call": ".balanceOf",
  "functions": [
   "claimReward",
   "getReward",
   "transfer",
   "transferFrom"
  ],
  "justification": "public functions sharing exposed accounting state"
 },
 "protocol": {
  "during_phase": "sendFee.exposed",
  "allowed_callbacks": [
   "claimReward",
   "getReward",
   "transfer",
   "transferFrom"
  ],
  "nesting_bound": {
   "sendFee": 1
  }
 },
 "phases": {
  "function": "sendFee",
  "pre": {
   "name": "pre",
   "from_marker": "function_entry",
   "to_marker": "before_external_call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "external_call",
   "to_marker": "call_return"
  },
  "post": {
   "name": "post",
   "from_marker": "after_external_call",
   "to_marker": "function_exit"
  },
  "linearization_point": "effect commit in pre-phase"
 },
 "ghost_state": [],
 "exposure_invariant": {
  "formula": "feeQueue + LiqQueue <= balanceOf[address(this)]",
  "stable_formula": "feeQueue + LiqQueue <= balanceOf[address(this)]",
  "kind": "additive",
  "derived_from_pre": true
 },
 "composition": {
  "target_property": "feeQueue + LiqQueue <= balanceOf[address(this)]",
  "rule": "If pre establishes I_exp, every admissible callback preserves I_exp, the protocol over-approximates concrete callbacks, and post restores I_stable, then the target property holds under adversarial callbacks."
 }
}