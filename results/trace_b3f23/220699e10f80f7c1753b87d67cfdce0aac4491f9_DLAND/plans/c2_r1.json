{
 "contract": "DLAND",
 "closure": {
  "site_function": "retrieve_president",
  "site_call": ".call",
  "functions": [
   "transfer",
   "transferFrom"
  ],
  "justification": "All functions that touch _ethBal and involve external value transfers must be included in the closure."
 },
 "protocol": {
  "during_phase": "exposed",
  "allowed_callbacks": [
   "transfer",
   "transferFrom"
  ],
  "nesting_bound": {
   "transfer": 1,
   "transferFrom": 1
  }
 },
 "phases": {
  "function": "retrieve_president",
  "pre": {
   "name": "pre",
   "from_marker": "start",
   "to_marker": "before_call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "before_call",
   "to_marker": "after_call"
  },
  "post": {
   "name": "post",
   "from_marker": "after_call",
   "to_marker": "end"
  },
  "linearization_point": "after_call"
 },
 "ghost_state": [
  {
   "name": "inFlight",
   "sol_type": "uint256",
   "meaning": "Eth in the process of being withdrawn in callback",
   "backed_by_storage": false
  }
 ],
 "exposure_invariant": {
  "formula": "president_balance + marketing_balance + development_balance + coder_balance == _ethBal + inFlight",
  "stable_formula": "president_balance + marketing_balance + development_balance + coder_balance == _ethBal",
  "kind": "conserve",
  "derived_from_pre": false
 },
 "composition": {
  "target_property": "president_balance + marketing_balance + development_balance + coder_balance <= _ethBal",
  "rule": "establish the conservation invariant across callbacks ensuring that the total balances remain equal to _ethBal including inFlight during exposure."
 }
}