{
 "contract": "X7RLiquidityHub",
 "closure": {
  "site_function": "sendTreasuryBalance",
  "site_call": ".call",
  "functions": [
   "<fallback>",
   "processFees",
   "sendDistributeBalance",
   "sendTreasuryBalance"
  ],
  "justification": "public functions sharing exposed accounting state"
 },
 "protocol": {
  "during_phase": "sendTreasuryBalance.exposed",
  "allowed_callbacks": [
   "<fallback>",
   "processFees",
   "sendDistributeBalance"
  ],
  "nesting_bound": {
   "sendTreasuryBalance": 1
  }
 },
 "phases": {
  "function": "sendTreasuryBalance",
  "pre": {
   "name": "pre",
   "from_marker": "function_entry",
   "to_marker": "before_external_call"
  },
  "exposed": {
   "name": "exposed",
   "from_marker": "external_call",
   "to_marker": "call_return"
  },
  "post": {
   "name": "post",
   "from_marker": "after_external_call",
   "to_marker": "function_exit"
  },
  "linearization_point": "effect commit in pre-phase"
 },
 "ghost_state": [
  {
   "name": "inFlight",
   "sol_type": "uint256",
   "meaning": "quantity committed but not yet settled across the callback window",
   "backed_by_storage": false
  },
  {
   "name": "ethToSend",
   "sol_type": "uint256",
   "meaning": "value the pre-phase read from treasuryBalance",
   "backed_by_storage": true
  }
 ],
 "exposure_invariant": {
  "formula": "distributeBalance + treasuryBalance + liquidityBalance <= _ethBal && ethToSend == treasuryBalance",
  "stable_formula": "distributeBalance + treasuryBalance + liquidityBalance <= _ethBal",
  "kind": "additive",
  "derived_from_pre": true
 },
 "composition": {
  "target_property": "distributeBalance + treasuryBalance + liquidityBalance <= _ethBal",
  "rule": "If pre establishes I_exp, every admissible callback preserves I_exp, the protocol over-approximates concrete callbacks, and post restores I_stable, then the target property holds under adversarial callbacks."
 }
}